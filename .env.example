# Public (exposed to client). Prefix with PUBLIC_.
PUBLIC_SITE_URL=https://grow.glitchexecutor.com
PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (choose one provider or leave empty to render nothing).
# PUBLIC_ANALYTICS_PROVIDER=plausible
# PUBLIC_ANALYTICS_DOMAIN=grow.glitchexecutor.com
# PUBLIC_ANALYTICS_PROVIDER=umami
# PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# PUBLIC_ANALYTICS_PROVIDER=ga4
# PUBLIC_GA_MEASUREMENT_ID=G-TK7ZYVLJRQ

# Meta (Facebook) Pixel — set to fire alongside the primary analytics provider.
# Each Glitch domain has its own pixel:
#   grow.glitchexecutor.com   → 1273074111260527  (this site)
#   glitchexecutor.com (apex) → 1238175855166679  (trading product / Stripe purchase)
# Cross-domain Purchase attribution for ads landing here is handled
# server-side: payment/server.py also fires the Purchase event to this
# pixel via CAPI when the user originated on grow (see external_id +
# fbc/fbp propagation through Stripe metadata).
# PUBLIC_META_PIXEL_ID=1273074111260527

# Google Tag Manager — site-specific container GTM-MPJTQK3K ("Tejas
# Protfolio"). The shared glitchexecutor container GTM-TMXWNNLJ is NOT
# used here. Configure GA4 + Meta Pixel as tags inside this container
# (firing on All Pages) and leave the direct PUBLIC_GA_MEASUREMENT_ID
# / PUBLIC_META_PIXEL_ID env vars unset to avoid double-counting.
# PUBLIC_GTM_CONTAINER_ID=GTM-MPJTQK3K

# Server-only (Cloudflare Pages → Settings → Environment variables).
# Do NOT prefix with PUBLIC_.
TURNSTILE_SECRET=

# Resend — contact-form deliveries land at RESEND_TO.
RESEND_API_KEY=
RESEND_FROM=Glitch Grow <support@glitchexecutor.com>
RESEND_TO=support@glitchexecutor.com
# Set to "true" to also send a branded thank-you email to the submitter.
RESEND_AUTOREPLY=

# Optional additional sinks.
SLACK_WEBHOOK_URL=
CONTACT_FORWARD_URL=
