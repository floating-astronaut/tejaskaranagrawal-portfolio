---
import { nav, site } from '~/lib/site';
import SocialIcons from '~/components/SocialIcons.astro';
const year = new Date().getFullYear();
---
<footer class="border-t border-border/60 bg-bg">
  <div class="container-app grid gap-10 py-10 md:grid-cols-[1.5fr_1fr_1fr] md:py-12">
    <div>
      <div class="mb-4 flex items-center gap-2.5">
        <img src="/assets/brand/mark-128.png" alt="" width="32" height="32" class="h-8 w-8 rounded-full border border-brand/40 object-cover" loading="lazy" />
        <span class="font-semibold">Tejas <span class="text-brand">Karan</span> Agrawal</span>
      </div>
      <p class="max-w-prose-tight text-fluid-sm text-muted">{site.description}</p>
      <p class="mt-4 text-fluid-xs text-subtle">A founder-operator portfolio built from real shipped systems.</p>
      <div class="mt-5"><SocialIcons label="Footer social profiles" /></div>
    </div>
    <nav aria-label="Footer primary" class="text-fluid-sm">
      <h3 class="eyebrow mb-4">Navigate</h3>
      <ul class="space-y-2 text-muted">{nav.map((item) => <li><a class="flex min-h-10 items-center hover:text-fg" href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <div class="text-fluid-sm">
      <h3 class="eyebrow mb-4">Contact</h3>
      <ul class="space-y-2 text-muted">
        <li><a class="flex min-h-10 items-center hover:text-fg" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>
        <li><a class="flex min-h-10 items-center hover:text-fg" href={site.github} target="_blank" rel="noreferrer">GitHub — floating-astronaut</a></li>
        <li><a class="flex min-h-10 items-center hover:text-fg" href={site.gitlab} target="_blank" rel="noreferrer">GitLab — floating-astronaut</a></li>
        <li><a class="flex min-h-10 items-center hover:text-fg" href="https://glitchexecutor.com">Glitch Executor Labs</a></li>
      </ul>
    </div>
  </div>
  <div class="container-app flex flex-col items-start justify-between gap-3 pb-10 text-fluid-xs text-subtle sm:flex-row sm:items-center">
    <p>© {year} Tejas Karan Agrawal. All rights reserved.</p>
    <p class="font-mono">Astro static · Cloudflare · nginx</p>
  </div>
</footer>
