---
import Icon from '~/components/Icon.astro';

// The "what this is NOT" disqualifying section. Critically important for
// cold-ad funnels — sets honest expectations, kills wrong-fit buyers before
// they buy and refund.
const notList = [
  'A course (no theory, no homework, no certificate)',
  'A managed AI agency (you own the deployment, you keep your keys, you ship your own product)',
  'A guarantee that you\'ll make money (it\'s a tool — what you build is on you)',
  'ChatGPT prompts in a PDF (those are free)',
  'A way to skip Claude Code subscription ($20/mo on you, separately)',
];
---

<section id="not-included" class="py-8 md:py-10 lg:py-14">
  <div class="container-app max-w-3xl">
    <div class="reveal">
      <p class="eyebrow"><Icon name="shield" size={14} /> What this is NOT</p>
      <h2 class="mt-4">Honest disqualifications.</h2>
      <p class="mt-5 text-fluid-base text-muted">
        Cold-ad refund rates are awful when buyers misread the offer. Here's
        every thing this kit is *not*, so you don't buy on the wrong premise.
      </p>
    </div>

    <ul class="mt-10 space-y-3" role="list">
      {notList.map((item) => (
        <li class="flex items-start gap-3 card p-4">
          <span class="mt-[2px] text-subtle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 6l12 12M6 18L18 6" />
            </svg>
          </span>
          <span class="text-fg/90 text-fluid-sm">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
