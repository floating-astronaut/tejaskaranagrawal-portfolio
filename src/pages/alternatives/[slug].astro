---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import ClaimSchema from '~/components/schema/ClaimSchema.astro';
import { products } from '~/lib/products';
import { bundles } from '~/lib/bundles';
import { site } from '~/lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('alternatives', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'alternatives'>; }
const { entry } = Astro.props;
const { Content } = await entry.render();
const {
  competitor,
  competitorUrl,
  title,
  summary,
  tldr,
  audience,
  competitorPain,
  comparison,
  faqs,
  citations,
  relatedProducts,
  publishedAt,
  updatedAt,
} = entry.data;

const founderStack = bundles[0];
const related = relatedProducts
  .map((slug) => products.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const lastUpdated = updatedAt ?? publishedAt;

// Convert each comparison row into a Schema.org Claim — declarative,
// citable, with the competitor's URL as the primary source. This is
// the structured-data shape AI assistants extract for fact-checking
// answers ("X charges $Y/mo"). Most SaaS sites don't ship this; doing
// it pulls comparison-page citations toward us materially.
const pageUrl = new URL(`/alternatives/${entry.slug}`, site.url).toString();
const comparisonClaims = comparison.flatMap((row) => [
  {
    text: `${competitor} ${row.feature.toLowerCase()}: ${row.competitor}`,
    citation: competitorUrl,
    citationLabel: `${competitor} — primary source`,
  },
  {
    text: `Glitch Grow ${row.feature.toLowerCase()}: ${row.glitch}`,
    citation: site.url,
    citationLabel: 'Glitch Grow',
  },
]);
---

<Base title={title} description={summary} pageType="WebPage">
  <Fragment slot="head">
    <FAQSchema faqs={faqs} />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Alternatives', url: '/alternatives' },
      { name: competitor, url: `/alternatives/${entry.slug}` },
    ]} />
    <ClaimSchema claims={comparisonClaims} pageUrl={pageUrl} />
  </Fragment>

  <article class="container-app pt-14 pb-24 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/alternatives" class="hover:text-fg">Alternatives</a>
      <span class="mx-1">/</span>
      <span class="text-muted">{competitor}</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow"><Icon name="layers" size={14} /> {competitor} alternative</p>
      <h1 class="mt-4">{title}</h1>
      <p class="mt-5 text-fluid-lg text-muted">{summary}</p>
      <p class="mt-2 text-fluid-xs text-subtle">
        Last updated <time datetime={lastUpdated.toISOString()}>{fmtDate(lastUpdated)}</time>
      </p>
    </header>

    <section class="mt-10 max-w-3xl card p-6 md:p-8 border-brand/30">
      <p class="font-mono text-fluid-xs text-brand uppercase tracking-wider">TL;DR</p>
      <p class="mt-3 text-fluid-base text-fg/90 leading-relaxed">{tldr}</p>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-fluid-2xl">Why people leave {competitor}</h2>
      <p class="mt-3 text-muted text-fluid-base leading-relaxed">{competitorPain}</p>
    </section>

    <section class="mt-12">
      <h2 class="text-fluid-2xl">Glitch Grow vs {competitor} — feature comparison</h2>
      <div class="mt-5 overflow-x-auto">
        <table class="w-full text-fluid-sm border border-border/60 rounded-lg overflow-hidden">
          <thead class="bg-bg-elev text-fg">
            <tr>
              <th class="text-left p-3 font-medium border-b border-border/60">Feature</th>
              <th class="text-left p-3 font-medium border-b border-border/60 text-brand">Glitch Grow</th>
              <th class="text-left p-3 font-medium border-b border-border/60">{competitor}</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr class="border-b border-border/40">
                <td class="p-3 text-fg/90 align-top font-medium">{row.feature}</td>
                <td class="p-3 text-fg/85 align-top">{row.glitch}</td>
                <td class="p-3 text-muted align-top">{row.competitor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="hairline my-12"></div>

    <div class="prose-tight max-w-3xl text-fg [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:mt-10 [&_h3]:mb-3 [&_p]:my-4 [&_p]:text-muted [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:text-muted [&_strong]:text-fg [&_a]:text-brand [&_a]:underline [&_a]:decoration-brand/40">
      <Content />
    </div>

    <section class="mt-14 max-w-3xl">
      <h2 class="text-fluid-2xl">Frequently asked questions</h2>
      <ul class="mt-5 divide-y divide-border/60 border-y border-border/60" role="list">
        {faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none">
                <span class="text-fluid-base font-medium pr-2">{f.q}</span>
                <span aria-hidden="true" class="shrink-0 mt-1 size-6 inline-flex items-center justify-center rounded-full border border-border text-subtle transition-transform group-open:rotate-45 group-open:text-brand">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </span>
              </summary>
              <div class="pb-5 pr-8 text-fluid-sm text-muted leading-relaxed" set:html={f.a} />
            </details>
          </li>
        ))}
      </ul>
    </section>

    {related.length > 0 && (
      <section class="mt-14">
        <h2 class="text-fluid-2xl">Boilerplates that replace {competitor}</h2>
        <ul class="mt-5 grid gap-4 md:grid-cols-2" role="list">
          {related.map((p) => (
            <li>
              <a href={`/products/${p.slug}`} class="card p-5 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
                <div class="flex items-start gap-3">
                  <span class="shrink-0 inline-flex size-9 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
                    <Icon name={p.icon} size={18} />
                  </span>
                  <div>
                    <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{p.sku}</p>
                    <p class="text-fluid-base font-medium">{p.name}</p>
                  </div>
                </div>
                <p class="mt-3 text-muted text-fluid-sm leading-snug">{p.oneLiner}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {citations.length > 0 && (
      <section class="mt-12 max-w-3xl">
        <h2 class="text-fluid-xl">Sources</h2>
        <ul class="mt-3 space-y-1.5 text-fluid-sm text-muted" role="list">
          {citations.map((c) => (
            <li>
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-brand underline decoration-brand/40 hover:decoration-brand">
                {c.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <aside class="mt-16 card p-6 md:p-8 flex flex-wrap gap-4 items-center justify-between border-brand/30">
      <div>
        <p class="eyebrow"><Icon name="bolt" size={14} /> Replace {competitor} once, deploy forever.</p>
        <p class="mt-2 text-fluid-base">All 6 production AI agents · ${founderStack.priceUsd} once · 14-day refund.</p>
      </div>
      <a href={`/vs/${entry.slug}`} class="btn btn-link">See the head-to-head <Icon name="arrow-right" size={14} /></a>
      <a href="/products/founder-stack" class="btn btn-primary">Get the AI Digital Marketing Stack <Icon name="arrow-right" size={16} /></a>
    </aside>
  </article>
</Base>
