---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import { competitors, personas, type Competitor, type Persona } from '~/data/pseo-matrix';
import { products } from '~/lib/products';
import { bundles } from '~/lib/bundles';

// Build 60 static paths: every competitor × every persona.
export function getStaticPaths() {
  const paths: Array<{ params: { slug: string; persona: string }, props: { competitor: Competitor; persona: Persona } }> = [];
  for (const competitor of competitors) {
    for (const persona of personas) {
      paths.push({
        params: { slug: competitor.slug, persona: persona.slug },
        props: { competitor, persona },
      });
    }
  }
  return paths;
}

interface Props { competitor: Competitor; persona: Persona; }
const { competitor, persona } = Astro.props;

const founderStack = bundles[0];

// Glitch products that intersect competitor's relevant set AND persona priority.
// Falls back to persona priority if there's no overlap (rare).
const relevantSlugs = (() => {
  const overlap = persona.priorityProducts.filter((s) => competitor.glitchProducts.includes(s));
  return overlap.length ? overlap : persona.priorityProducts.slice(0, 3);
})();
const relevantProducts = relevantSlugs
  .map((slug) => products.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .slice(0, 3);

// Page meta — exact-match title for the long-tail intent.
const title = `${competitor.name} alternative for ${persona.nounPlural}`;
const description = `${competitor.name} alternative built for ${persona.nounPlural}. ${persona.pain} ${persona.fit}`;

// Tailored FAQs combining competitor + persona context.
const faqs = [
  {
    q: `Why look beyond ${competitor.name} as ${aOrAn(persona.noun)} ${persona.noun}?`,
    a: `${competitor.whyLeave} For ${persona.nounPlural} specifically, ${persona.pain.toLowerCase()}`,
  },
  {
    q: `What does Glitch Grow give ${aOrAn(persona.noun)} ${persona.noun} that ${competitor.name} doesn't?`,
    a: `${persona.fit} The AI Digital Marketing Stack ($${founderStack.priceUsd} once) ships six AI agents — for ${persona.nounPlural}, the most relevant are typically ${relevantProducts.map((p) => p.name).join(', ')}.`,
  },
  {
    q: `How long does it take to deploy a Glitch Grow agent compared with ${competitor.name}?`,
    a: `${competitor.name} is faster to start with — its UI is built for that. Glitch Grow's first deploy is ~2 hours; client #2 onward is ~20 minutes thanks to the brand-config schema. The trade is upfront time for ongoing ownership.`,
  },
  {
    q: `Can I keep using ${competitor.name} for some workloads?`,
    a: `Yes — most ${persona.nounPlural} who switch keep ${competitor.name} for what it's actually best at and use Glitch Grow for the agent-shaped workloads where the per-${competitor.category === 'voice' ? 'minute' : competitor.category === 'sequence' ? 'sender' : 'task'} pricing breaks down.`,
  },
  {
    q: `What's the licensing model?`,
    a: `Business Source License 1.1. ${persona.nounPlural} can rebrand each deployment, deliver to clients, and run on their own infrastructure. The only constraint is you cannot repackage the kit itself as a competing kit.`,
  },
];

function aOrAn(word: string): string {
  return /^[aeiouAEIOU]/.test(word) ? 'an' : 'a';
}
---

<Base title={title} description={description} pageType="WebPage">
  <Fragment slot="head">
    <FAQSchema faqs={faqs} />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Alternatives', url: '/alternatives' },
      { name: competitor.name, url: competitor.hasDeepPage ? `/alternatives/${competitor.slug}` : `/alternatives/${competitor.slug}/for-${persona.slug}` },
      { name: `For ${persona.label}`, url: `/alternatives/${competitor.slug}/for-${persona.slug}` },
    ]} />
  </Fragment>

  <article class="container-app pt-14 pb-24 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/alternatives" class="hover:text-fg">Alternatives</a>
      <span class="mx-1">/</span>
      {competitor.hasDeepPage ? (
        <a href={`/alternatives/${competitor.slug}`} class="hover:text-fg">{competitor.name}</a>
      ) : (
        <span class="text-muted">{competitor.name}</span>
      )}
      <span class="mx-1">/</span>
      <span class="text-muted">For {persona.label}</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow"><Icon name="layers" size={14} /> {competitor.name} alternative · {persona.label}</p>
      <h1 class="mt-4">{title}.</h1>
      <p class="mt-5 text-fluid-lg text-muted">
        {description}
      </p>
    </header>

    {/* TL;DR — combines persona + competitor angles uniquely per page */}
    <section class="mt-10 max-w-3xl card p-6 md:p-8 border-brand/30">
      <p class="label-ui text-brand">TL;DR</p>
      <p class="mt-3 text-fluid-base text-fg/90 leading-relaxed">
        {competitor.name} is {competitor.oneLiner.toLowerCase()} — {competitor.pricingNote} For {persona.nounPlural}, that pricing model fights you: {persona.pain.toLowerCase()} Glitch Grow flips it: a one-time ${founderStack.priceUsd} for six AI agents you self-host and white-label. Typical ${persona.noun} use case — {persona.example.toLowerCase()}
      </p>
    </section>

    {/* Why this combo matters — 100% persona-specific copy */}
    <section class="mt-12 max-w-3xl">
      <h2 class="text-fluid-2xl">Why {persona.nounPlural} look past {competitor.name}</h2>
      <p class="mt-3 text-muted text-fluid-base leading-relaxed">{competitor.whyLeave}</p>
      <p class="mt-3 text-muted text-fluid-base leading-relaxed">
        For {persona.nounPlural}, the friction is sharper. {persona.pain} A typical pricing reference for this segment is {persona.pricingContext.toLowerCase()} — and that's the budget the SaaS spend has to fit inside, not next to.
      </p>
    </section>

    {/* What Glitch Grow gives this persona — pulls in 2-3 actual product cards */}
    <section class="mt-12">
      <h2 class="text-fluid-2xl">What Glitch Grow gives {persona.nounPlural}</h2>
      <p class="mt-3 text-muted text-fluid-base leading-relaxed max-w-3xl">{persona.fit}</p>

      <ul class="mt-6 grid gap-4 md:grid-cols-3" role="list">
        {relevantProducts.map((p) => (
          <li>
            <a href={`/products/${p.slug}`} class="card p-5 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
              <div class="flex items-start gap-3">
                <span class="shrink-0 inline-flex size-9 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
                  <Icon name={p.icon} size={18} />
                </span>
                <div>
                  <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{p.sku}</p>
                  <p class="text-fluid-base font-medium">{p.name}</p>
                </div>
              </div>
              <p class="mt-3 text-muted text-fluid-sm leading-snug">{p.oneLiner}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* Concrete example block */}
    <section class="mt-12 max-w-3xl card p-6 md:p-8">
      <p class="label-ui text-brand">Example use case</p>
      <p class="mt-3 text-fluid-base text-fg/90 leading-relaxed">{persona.example}</p>
    </section>

    {/* FAQs — tailored to combo, FAQPage schema emits in head slot */}
    <section class="mt-14 max-w-3xl">
      <h2 class="text-fluid-2xl">Frequently asked questions</h2>
      <ul class="mt-5 divide-y divide-border/60 border-y border-border/60" role="list">
        {faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none">
                <span class="text-fluid-base font-medium pr-2">{f.q}</span>
                <span aria-hidden="true" class="shrink-0 mt-1 size-6 inline-flex items-center justify-center rounded-full border border-border text-subtle transition-transform group-open:rotate-45 group-open:text-brand">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </span>
              </summary>
              <p class="pb-5 pr-8 text-fluid-sm text-muted leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </section>

    {/* Cross-links to deeper content */}
    <section class="mt-12 grid gap-4 md:grid-cols-2 max-w-3xl">
      {competitor.hasDeepPage && (
        <a href={`/alternatives/${competitor.slug}`} class="card p-5 hover:border-brand/40">
          <p class="label-ui text-brand">Deep comparison</p>
          <p class="mt-2 text-fluid-base font-medium">Full {competitor.name} alternative breakdown</p>
          <p class="mt-1 text-muted text-fluid-sm">Comparison table, all FAQs, sources.</p>
        </a>
      )}
      <a href="/tools/saas-vs-own-calculator" class="card p-5 hover:border-brand/40">
        <p class="label-ui text-brand">Calculator</p>
        <p class="mt-2 text-fluid-base font-medium">SaaS-vs-Own 3-year TCO</p>
        <p class="mt-1 text-muted text-fluid-sm">Plug in your current stack, share the result.</p>
      </a>
    </section>

    <aside class="mt-16 card p-6 md:p-8 flex flex-wrap gap-4 items-center justify-between border-brand/30">
      <div>
        <p class="eyebrow"><Icon name="bolt" size={14} /> Pay once, deploy forever.</p>
        <p class="mt-2 text-fluid-base">All 6 production AI agents · ${founderStack.priceUsd} once · 14-day refund.</p>
      </div>
      <a href="/products/founder-stack" class="btn btn-primary">
        Get the Stack <Icon name="arrow-right" size={16} />
      </a>
    </aside>
  </article>
</Base>
