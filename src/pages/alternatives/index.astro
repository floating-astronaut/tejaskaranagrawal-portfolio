---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { competitors, personas } from '~/data/pseo-matrix';

// Deep alternatives pages live in src/content/alternatives/*.mdx — those
// have full comparison tables + sources. The pSEO matrix at
// /alternatives/{slug}/for-{persona} provides persona-specific entry
// points for every competitor in src/data/pseo-matrix.ts.
const deepEntries = (await getCollection('alternatives', ({ data }) => !data.draft));
const deepBySlug = new Map<string, (typeof deepEntries)[number]>(
  deepEntries.map((e) => [e.slug as string, e]),
);

const sortedCompetitors = [...competitors].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="Alternatives to common AI agent and automation tools"
  description="Honest comparisons between Glitch Grow and the AI/automation tools agencies stack — Zapier, Make, n8n, Vapi, Smartlead, Lindy AI, and more — plus persona-specific pages for agency owners, freelancers, indie devs, ecommerce founders, and B2B SaaS operators."
  pageType="WebPage"
>
  <article class="container-app pt-14 pb-20 md:pt-20">
    <header class="max-w-3xl">
      <p class="eyebrow"><Icon name="layers" size={14} /> Alternatives</p>
      <h1 class="mt-4">Alternatives to the tools agencies stack.</h1>
      <p class="mt-5 text-fluid-lg text-muted">
        Honest, sourced comparisons. We list when <em>not</em> to use Glitch Grow too. Each competitor has a deep breakdown plus persona-specific pages for {personas.map((p) => p.label.toLowerCase()).join(', ')}.
      </p>
      <p class="mt-4 text-fluid-sm text-subtle">
        Looking for the master table? See <a href="/compare" class="text-brand underline">all 12 tools side-by-side at /compare</a>.
      </p>
    </header>

    <section class="mt-10">
      <h2 class="sr-only">Competitors</h2>
      <ul class="grid gap-6" role="list">
        {sortedCompetitors.map((c) => {
          const deep = deepBySlug.get(c.slug);
          return (
            <li class="card p-6">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <div>
                  <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{c.category.replace('-', ' ')}</p>
                  <h3 class="mt-2 text-fluid-xl font-medium">
                    {deep
                      ? <a href={`/alternatives/${c.slug}`} class="hover:text-brand">{c.name}</a>
                      : <span>{c.name}</span>}
                  </h3>
                  <p class="mt-2 text-muted text-fluid-sm leading-snug max-w-2xl">{c.oneLiner} {c.pricingNote}</p>
                </div>
                {deep && (
                  <a href={`/alternatives/${c.slug}`} class="btn-link text-fluid-sm">
                    Deep comparison <Icon name="arrow-right" size={14} />
                  </a>
                )}
              </div>

              <div class="mt-5 pt-5 border-t border-border/40">
                <p class="label-ui">For specific personas</p>
                <ul class="mt-3 flex flex-wrap gap-2" role="list">
                  {personas.map((p) => (
                    <li>
                      <a
                        href={`/alternatives/${c.slug}/for-${p.slug}`}
                        class="inline-flex items-center px-3 py-1 rounded-md border border-border/60 text-fluid-sm text-fg/90 hover:border-brand/40 hover:text-brand"
                      >
                        For {p.label.toLowerCase()}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  </article>
</Base>
