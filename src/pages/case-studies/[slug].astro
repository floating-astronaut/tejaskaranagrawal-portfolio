---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('case-studies', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'case-studies'>; }
const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, summary, headline, client, industry, metrics, publishedAt, updatedAt } = entry.data;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Organization', name: site.parent },
  publisher: { '@type': 'Organization', name: site.parent },
  mainEntityOfPage: new URL(`/case-studies/${entry.slug}`, site.url).toString(),
};
---

<Base
  title={title}
  description={summary}
  pageType="WebPage"
  ogSlug={`case-${entry.slug}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd).replaceAll('</', '<\\/')} is:inline />
  </Fragment>

  <article class="container-app pt-14 pb-24 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/case-studies" class="hover:text-fg">Case studies</a>
      <span class="mx-1">/</span>
      <span class="text-muted">{client}</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow">{industry}</p>
      <h1 class="mt-4">{title}</h1>
      <p class="mt-5 text-fluid-lg text-muted">{summary}</p>
      <p class="mt-6 font-mono text-brand text-fluid-xl">{headline}</p>
    </header>

    <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3">
      {metrics.map((m) => (
        <div class="card p-4">
          <dt class="text-fluid-xs uppercase tracking-wider text-subtle">{m.label}</dt>
          <dd class="mt-1 font-mono text-fluid-xl text-fg">{m.value}</dd>
        </div>
      ))}
    </dl>

    <div class="hairline my-12"></div>

    <div class="prose-tight max-w-none text-fg [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:mt-10 [&_h3]:mb-3 [&_p]:my-4 [&_p]:text-muted [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:text-muted [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_strong]:text-fg [&_code]:font-mono [&_code]:text-brand [&_a]:text-brand [&_a]:underline [&_a]:decoration-brand/40">
      <Content />
    </div>

    <aside class="mt-16 card p-6 md:p-8 flex flex-wrap gap-4 items-center justify-between">
      <div>
        <p class="eyebrow"><Icon name="spark" size={14} /> Want the same playbook?</p>
        <p class="mt-2 text-fluid-lg">30-day fixed-scope pilot, measurable outcome, or refund.</p>
      </div>
      <a href="/#contact" class="btn btn-primary">
        Book a call <Icon name="arrow-right" size={16} />
      </a>
    </aside>
  </article>
</Base>
