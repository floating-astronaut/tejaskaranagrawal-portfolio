---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import ImageSlot from '~/components/ImageSlot.astro';
import { Image } from 'astro:assets';

const entries = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Base
  title="Case Studies"
  description="Selected case studies from Glitch Grow — how we rebuild attribution, unlock wasted spend, and scale e-commerce with AI."
  pageType="WebPage"
  ogSlug="case-studies"
>
  <section class="container-app pt-16 pb-10 md:pt-24">
    <p class="eyebrow"><Icon name="chart" size={14} /> Case Studies</p>
    <h1 class="mt-4">Receipts, not decks.</h1>
    <p class="mt-5 max-w-[56ch] text-fluid-lg text-muted">
      Each case below ran on real accounts, real budgets, real timelines.
      Numbers are rounded to two significant figures and attributed to the source
      of truth (Meta Ads Manager, Shopify, Amazon Seller Central).
    </p>
  </section>

  <section class="container-app pb-24">
    <ul role="list" class="grid gap-6 md:grid-cols-2">
      {entries.map((entry) => (
        <li>
          <a
            href={`/case-studies/${entry.slug}`}
            class="card p-6 md:p-8 block h-full transition-transform hover:-translate-y-0.5"
          >
            {entry.data.cover ? (
              <Image
                src={entry.data.cover}
                alt={entry.data.coverAlt ?? entry.data.title}
                widths={[360, 480, 720, 960]}
                sizes="(min-width: 768px) 480px, 100vw"
                loading="lazy"
                class="rounded-md mb-6 w-full h-auto"
              />
            ) : (
              <ImageSlot
                w={960}
                h={540}
                ratio="16 / 9"
                label={entry.data.coverAlt ?? entry.data.client}
                alt={entry.data.coverAlt ?? entry.data.title}
                rounded="md"
                class="mb-6"
              />
            )}
            <p class="eyebrow">{entry.data.industry}</p>
            <h2 class="mt-3 text-fluid-2xl">{entry.data.title}</h2>
            <p class="mt-3 text-muted text-fluid-sm">{entry.data.summary}</p>
            <p class="mt-5 font-mono text-brand text-fluid-sm">{entry.data.headline}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-fluid-sm">
              Read case <Icon name="arrow-up-right" size={14} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
