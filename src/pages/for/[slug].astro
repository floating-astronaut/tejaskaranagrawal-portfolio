---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import { audiences, type Audience } from '~/data/audiences';
import { competitors as pseoCompetitors } from '~/data/pseo-matrix';
import { products } from '~/lib/products';
import { bundles } from '~/lib/bundles';

export function getStaticPaths() {
  return audiences.map((a) => ({ params: { slug: a.slug }, props: { audience: a } }));
}

interface Props { audience: Audience; }
const { audience } = Astro.props;

const founderStack = bundles[0];

const audienceProducts = audience.productSlugs
  .map((s) => products.find((p) => p.slug === s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const audienceCompetitors = audience.competitorSlugs
  .map((s) => pseoCompetitors.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<Base title={audience.h1} description={audience.blurb} pageType="WebPage">
  <Fragment slot="head">
    <FAQSchema faqs={audience.faqs} />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'For', url: '/for' },
      { name: audience.label, url: `/for/${audience.slug}` },
    ]} />
  </Fragment>

  <article class="container-app pt-14 pb-24 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/for" class="hover:text-fg">For</a>
      <span class="mx-1">/</span>
      <span class="text-muted">{audience.label}</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow">
        <Icon name="layers" size={14} />
        {audience.type === 'persona' ? 'For' : 'Industry'} · {audience.label}
      </p>
      <h1 class="mt-4">{audience.h1}.</h1>
      <p class="mt-5 text-fluid-lg text-muted">{audience.blurb}</p>
    </header>

    <section class="mt-10 grid gap-6 md:grid-cols-2 max-w-4xl">
      <div class="card p-6">
        <p class="eyebrow"><Icon name="arrow-up-right" size={14} /> The pain</p>
        <ul class="mt-4 space-y-2.5" role="list">
          {audience.pains.map((p) => (
            <li class="flex items-start gap-2.5 text-fluid-sm text-muted leading-snug">
              <span class="mt-[3px] text-subtle shrink-0"><Icon name="arrow-right" size={14} /></span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="card p-6 border-brand/30">
        <p class="eyebrow"><Icon name="check" size={14} /> What fits</p>
        <ul class="mt-4 space-y-2.5" role="list">
          {audience.fits.map((f) => (
            <li class="flex items-start gap-2.5 text-fluid-sm text-fg/90 leading-snug">
              <span class="mt-[3px] text-brand shrink-0"><Icon name="check" size={14} /></span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-12 max-w-3xl card p-6 md:p-8">
      <p class="label-ui text-brand">Pricing context</p>
      <p class="mt-3 text-fluid-base text-fg/90 leading-relaxed">{audience.pricingContext}</p>
    </section>

    <section class="mt-12">
      <h2 class="text-fluid-2xl">Most relevant agents for {audience.label.toLowerCase()}</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4" role="list">
        {audienceProducts.map((p) => (
          <li>
            <a href={`/products/${p.slug}`} class="card p-5 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
              <div class="flex items-start gap-3">
                <span class="shrink-0 inline-flex size-9 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
                  <Icon name={p.icon} size={18} />
                </span>
                <div>
                  <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{p.sku}</p>
                  <p class="text-fluid-base font-medium leading-tight">{p.name}</p>
                </div>
              </div>
              <p class="mt-3 text-muted text-fluid-sm leading-snug">{p.oneLiner}</p>
              <p class="mt-3 font-mono text-fluid-sm text-fg">${p.priceUsd}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-fluid-2xl">Tools {audience.label.toLowerCase()} typically evaluate</h2>
      <p class="mt-3 text-muted text-fluid-base leading-relaxed max-w-3xl">
        Honest comparisons against the alternatives this audience considers most. Each links to the full breakdown.
      </p>
      <ul class="mt-5 grid gap-3 md:grid-cols-2 lg:grid-cols-3" role="list">
        {audienceCompetitors.map((c) => (
          <li>
            <a href={`/alternatives/${c.slug}`} class="card p-4 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
              <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{c.category.replace('-', ' ')}</p>
              <p class="mt-1 text-fluid-base font-medium">{c.name}</p>
              <p class="mt-1 text-muted text-fluid-xs leading-snug">{c.oneLiner}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14 max-w-3xl">
      <h2 class="text-fluid-2xl">Frequently asked questions</h2>
      <ul class="mt-5 divide-y divide-border/60 border-y border-border/60" role="list">
        {audience.faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none">
                <span class="text-fluid-base font-medium pr-2">{f.q}</span>
                <span aria-hidden="true" class="shrink-0 mt-1 size-6 inline-flex items-center justify-center rounded-full border border-border text-subtle transition-transform group-open:rotate-45 group-open:text-brand">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </span>
              </summary>
              <p class="pb-5 pr-8 text-fluid-sm text-muted leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </section>

    <aside class="mt-16 card p-6 md:p-8 flex flex-wrap gap-4 items-center justify-between border-brand/30">
      <div>
        <p class="eyebrow"><Icon name="bolt" size={14} /> One bundle, six agents.</p>
        <p class="mt-2 text-fluid-base">${founderStack.priceUsd} once · 14-day refund · BSL 1.1 license permits client resale.</p>
      </div>
      <a href="/products/founder-stack" class="btn btn-primary">
        Get the AI Digital Marketing Stack <Icon name="arrow-right" size={16} />
      </a>
    </aside>
  </article>
</Base>
