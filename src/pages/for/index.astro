---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { audiences } from '~/data/audiences';

const personas = audiences.filter((a) => a.type === 'persona');
const industries = audiences.filter((a) => a.type === 'industry');
---

<Base
  title="Glitch Grow — for your audience"
  description="Curated landing pages by persona (agency owners, freelancers, indie devs, ecommerce founders, B2B SaaS) and industry (Indian D2C, Shopify merchants, resale agencies)."
  pageType="WebPage"
>
  <article class="container-app pt-14 pb-20 md:pt-20">
    <header class="max-w-3xl">
      <p class="eyebrow"><Icon name="layers" size={14} /> For</p>
      <h1 class="mt-4">Pick the page that matches you.</h1>
      <p class="mt-5 text-fluid-lg text-muted">
        Curated by audience — what fits, what doesn't, what to expect at your scale.
      </p>
    </header>

    <section class="mt-12">
      <h2 class="text-fluid-xl">By persona</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-3" role="list">
        {personas.map((a) => (
          <li>
            <a href={`/for/${a.slug}`} class="card p-6 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
              <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">Persona</p>
              <h3 class="mt-2 text-fluid-base font-medium leading-tight">{a.label}</h3>
              <p class="mt-2 text-muted text-fluid-sm leading-snug">{a.blurb}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-fluid-xl">By industry</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-3" role="list">
        {industries.map((a) => (
          <li>
            <a href={`/for/${a.slug}`} class="card p-6 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
              <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">Industry</p>
              <h3 class="mt-2 text-fluid-base font-medium leading-tight">{a.label}</h3>
              <p class="mt-2 text-muted text-fluid-sm leading-snug">{a.blurb}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Base>
