---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import JsonLd from '~/components/JsonLd.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import { products } from '~/lib/products';
import { site } from '~/lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('glossary', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'glossary'>; }
const { entry } = Astro.props;
const { Content } = await entry.render();
const {
  term,
  title,
  definition,
  summary,
  related,
  citations,
  relatedProducts,
  publishedAt,
  updatedAt,
} = entry.data;

const relatedProductRefs = relatedProducts
  .map((slug) => products.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const lastUpdated = updatedAt ?? publishedAt;

// DefinedTerm schema — Google + LLMs use this for definition extraction.
const definedTermLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: term,
  description: definition,
  url: new URL(`/glossary/${entry.slug}`, site.url).toString(),
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'Glitch Grow Glossary',
    url: new URL('/glossary', site.url).toString(),
  },
};
---

<Base title={title} description={summary} pageType="WebPage">
  <Fragment slot="head">
    <JsonLd data={definedTermLd} />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Glossary', url: '/glossary' },
      { name: term, url: `/glossary/${entry.slug}` },
    ]} />
  </Fragment>

  <article class="container-app pt-14 pb-24 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/glossary" class="hover:text-fg">Glossary</a>
      <span class="mx-1">/</span>
      <span class="text-muted">{term}</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow"><Icon name="spark" size={14} /> Definition</p>
      <h1 class="mt-4">{title}</h1>
      <p class="mt-2 text-fluid-xs text-subtle">
        Last updated <time datetime={lastUpdated.toISOString()}>{fmtDate(lastUpdated)}</time>
      </p>
    </header>

    <section class="mt-10 max-w-3xl card p-6 md:p-8 border-brand/30">
      <p class="font-mono text-fluid-xs text-brand uppercase tracking-wider">Definition</p>
      <p class="mt-3 text-fluid-lg text-fg/95 leading-relaxed font-medium">{definition}</p>
      <p class="mt-4 text-fluid-base text-muted leading-relaxed">{summary}</p>
    </section>

    <div class="hairline my-12"></div>

    <div class="prose-tight max-w-3xl text-fg [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:mt-10 [&_h3]:mb-3 [&_p]:my-4 [&_p]:text-muted [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:text-muted [&_strong]:text-fg [&_a]:text-brand [&_a]:underline [&_a]:decoration-brand/40">
      <Content />
    </div>

    {related.length > 0 && (
      <section class="mt-12 max-w-3xl">
        <h2 class="text-fluid-xl">Related terms</h2>
        <ul class="mt-3 flex flex-wrap gap-2" role="list">
          {related.map((r) => (
            <li>
              <a href={`/glossary/${r}`} class="inline-flex items-center px-3 py-1 rounded-md border border-border/60 text-fluid-sm text-fg/90 hover:border-brand/40 hover:text-brand">
                {r.replace(/-/g, ' ')}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedProductRefs.length > 0 && (
      <section class="mt-12">
        <h2 class="text-fluid-xl">Related agents</h2>
        <ul class="mt-4 grid gap-4 md:grid-cols-2" role="list">
          {relatedProductRefs.map((p) => (
            <li>
              <a href={`/products/${p.slug}`} class="card p-5 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
                <div class="flex items-start gap-3">
                  <span class="shrink-0 inline-flex size-9 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
                    <Icon name={p.icon} size={18} />
                  </span>
                  <div>
                    <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{p.sku}</p>
                    <p class="text-fluid-base font-medium">{p.name}</p>
                  </div>
                </div>
                <p class="mt-3 text-muted text-fluid-sm leading-snug">{p.oneLiner}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {citations.length > 0 && (
      <section class="mt-12 max-w-3xl">
        <h2 class="text-fluid-xl">Sources</h2>
        <ul class="mt-3 space-y-1.5 text-fluid-sm text-muted" role="list">
          {citations.map((c) => (
            <li>
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-brand underline decoration-brand/40 hover:decoration-brand">
                {c.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
