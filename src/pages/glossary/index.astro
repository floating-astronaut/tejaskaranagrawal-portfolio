---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';

const entries = (await getCollection('glossary', ({ data }) => !data.draft))
  .sort((a, b) => a.data.term.localeCompare(b.data.term));
---

<Base
  title="AI agent & automation glossary"
  description="Plain-English definitions of the terms we use across Glitch Grow: AI agent, MCP server, agentic workflow, white-label AI, voice agent, RAG, function calling, and more."
  pageType="WebPage"
>
  <article class="container-app pt-14 pb-20 md:pt-20">
    <header class="max-w-3xl">
      <p class="eyebrow"><Icon name="spark" size={14} /> Glossary</p>
      <h1 class="mt-4">AI agent &amp; automation glossary.</h1>
      <p class="mt-5 text-fluid-lg text-muted">
        Plain definitions of the concepts behind Glitch Grow's AI agents — written so you can quote them in client conversations.
      </p>
    </header>

    <ul class="mt-10 grid gap-3 md:grid-cols-2" role="list">
      {entries.map((e) => (
        <li>
          <a href={`/glossary/${e.slug}`} class="card p-5 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
            <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{e.data.term}</p>
            <h2 class="mt-2 text-fluid-base font-medium leading-tight">{e.data.title}</h2>
            <p class="mt-2 text-muted text-fluid-sm leading-snug">{e.data.definition}</p>
          </a>
        </li>
      ))}
    </ul>
  </article>
</Base>
