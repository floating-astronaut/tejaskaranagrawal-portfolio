---
// India-variant homepage. Mirrors src/pages/index.astro but lives under /in/
// so geo-aware components auto-detect India context from Astro.url.pathname.
// Three KitCtaStrip insertions + Testimonials added (India page was missing it).

import Base from '~/layouts/Base.astro';
import Hero from '~/components/sections/Hero.astro';
import SaasVsOwnership from '~/components/sections/SaasVsOwnership.astro';
import TwoPaths from '~/components/sections/TwoPaths.astro';
import HowItWorks from '~/components/sections/HowItWorks.astro';
import AgentsCatalog from '~/components/sections/AgentsCatalog.astro';
import ResellerMath from '~/components/sections/ResellerMath.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import KitPricing from '~/components/sections/KitPricing.astro';
import FAQ from '~/components/sections/FAQ.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import KitCtaStrip from '~/components/sections/KitCtaStrip.astro';
---

<Base
  pageType="WebPage"
  ogSlug="home"
  title="Glitch Grow · India"
  description="Pre-built AI agents for Indian agency owners, freelancers, and indie devs. Pay in INR via Razorpay. Use them yourself or rebrand and resell to clients."
>
  <Hero />
  <SaasVsOwnership />
  <TwoPaths />
  <KitCtaStrip
    id="kit-strip-1"
    variant="outline"
    headline="Free Vibe Coder Kit — required before you install any paid agent."
    subhead="Pre-wires Claude Code, Codex, Cursor, OpenClaw with the MCPs and skills the agents expect. 60-second install."
  />
  <HowItWorks />
  <AgentsCatalog />
  <KitCtaStrip
    id="kit-strip-2"
    variant="solid"
    headline="Six agents. One stack. ₹9,999 lifetime."
    subhead="Free kit first. Then bundle all six and start delivering at ₹25,000–₹50,000 per client per month."
  />
  <ResellerMath />
  <Testimonials />
  <KitCtaStrip
    id="kit-strip-3"
    variant="outline"
    headline="Start with the free kit."
    subhead="Yours forever. No card, no subscription. Required for the ₹9,999 Stack."
  />
  <KitPricing />
  <FAQ />
  <CallToAction />
</Base>
