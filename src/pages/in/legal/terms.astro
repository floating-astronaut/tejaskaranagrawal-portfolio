---
import Base from '~/layouts/Base.astro';
import { site, legalEntityIN } from '~/lib/site';
const updated = '2026-05-05';
const entity = legalEntityIN;
---

<Base
  title="Terms of Service · India"
  description={`Terms of service for ${site.name} India operations, governed by ${entity.jurisdiction}.`}
  pageType="WebPage"
  noindex={false}
>
  <section class="container-app py-20 max-w-prose-tight">
    <p class="eyebrow">Legal · India</p>
    <h1 class="mt-4">Terms of Service</h1>
    <p class="mt-4 text-subtle text-fluid-sm">Last updated: {updated}</p>
    <p class="mt-2 text-subtle text-fluid-sm">
      Applicable to purchases made on the <code class="font-mono text-xs px-1 py-0.5 rounded bg-surface-2">/in/</code> variant of {site.domain} (INR pricing, Razorpay checkout). For purchases made on the global variant, see the <a href="/legal/terms" class="text-brand underline decoration-brand/40 hover:decoration-brand">global terms</a>.
    </p>

    <div class="prose mt-10 text-muted [&_h2]:text-fg [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-fluid-xl [&_h3]:text-fg [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-fluid-base [&_p]:my-3 [&_strong]:text-fg [&_ul]:list-disc [&_ul]:pl-6 [&_li]:my-1.5 [&_a]:text-brand">

