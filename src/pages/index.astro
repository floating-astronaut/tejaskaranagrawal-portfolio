---
import Base from '~/layouts/Base.astro';
import StackLogoMarquee from '~/components/StackLogoMarquee.astro';
import { site } from '~/lib/site';

const proof = [
  { value: '2018', label: 'Started learning digital marketing hands-on, then kept applying it in real campaigns, content, and commerce work.' },
  { value: '2Cr+', label: 'Total sales generated after scaling a dropshipping store, selling it to the vendor, and expanding together to four stores.' },
  { value: '4', label: 'E-commerce stores built and operated across product testing, paid traffic, suppliers, support, and automation.' },
  { value: '2', label: 'Canadian digital marketing diplomas added on top of years of self-taught execution.' },
];

const experience = [
  {
    role: 'Dropshipping / Ecom Specialist',
    org: 'Urban Classics Store',
    period: 'June 2023 - Present',
    place: 'India / Remote',
    summary: 'Started with one dropshipping store, scaled it, sold it to the vendor, and then helped expand the operation into four stores with paid growth and tighter operations.',
    bullets: [
      'Generated more than 2 crore in total sales across the expanded store portfolio.',
      'Handled the practical growth loop: product testing, store setup, ad campaigns, supplier coordination, customer support, and conversion feedback.',
      'Moved repetitive commerce work into automated flows, including post-purchase and WhatsApp-based retention touchpoints.',
    ],
  },
  {
    role: 'Performance Marketing Specialist',
    org: 'Quickads',
    period: 'October 2025 - March 2026',
    place: 'Texas, United States',
    summary: 'Worked inside a performance marketing environment while studying in Canada, contributing to campaign and creative workflows for brands including Udemy and Night Habit.',
    bullets: [
      'Supported paid growth execution where creative, targeting, and reporting had to connect to business outcomes.',
      'Saw how larger brand workflows operate, which sharpened my interest in AI-first marketing operations and faster testing systems.',
    ],
  },
  {
    role: 'Digital Marketing Specialist',
    org: 'IndoFolk Wellness',
    period: 'January 2025 - June 2025',
    place: 'India',
    summary: 'Supported USA and Canada Shopify launches with paid social strategy, creative coordination, and campaign reporting for wellness commerce.',
    bullets: [
      'Helped launch Shopify stores for North American markets.',
      'Developed TikTok marketing strategies and worked with designers on performance-oriented ad creative.',
      'Translated campaign data into actionable changes for better engagement and conversion rates.',
    ],
  },
  {
    role: 'Content Specialist',
    org: 'CableCommunity',
    period: 'August 2021 - February 2022',
    place: 'Delhi',
    summary: 'Owned content, SEO, and social distribution for renewable energy and electric vehicle topics.',
    bullets: [
      'Built a daily blog content strategy to increase traffic and engagement.',
      'Published technical articles and keyword-rich snippets to strengthen topical authority.',
      'Executed on-page and off-page SEO while managing social channels that routed readers back to the site.',
    ],
  },
  {
    role: 'Founder',
    org: 'Rcube Biotech & Energy LLP',
    period: 'November 2020 - August 2021',
    place: 'Gwalior, Madhya Pradesh',
    summary: 'Founded an innovation-led venture around Smart Bio-Toilet Bed and Smart Bio-Toilet Chair products for disabled and paralyzed people.',
    bullets: ['Took a first-of-its-kind product concept in India from idea into a positioned product with a clear user need and quality-led differentiation.'],
  },
  {
    role: 'Digital Marketing Executive',
    org: 'Digistreet Infocom Private Limited',
    period: 'January 2019 - June 2020',
    place: 'Greater Noida',
    summary: 'Ran social, PPC, SEO, and team execution for a startup focused heavily on real estate lead generation.',
    bullets: [
      'Managed social media and pay-per-click campaigns for lead generation.',
      'Handled SEO and organic traffic activity for the company website.',
      'Managed a four-person team as the company\'s first hire.',
    ],
  },
  {
    role: 'SIES Executive',
    org: 'ASC Group',
    period: 'March 2018 - April 2018',
    place: 'Noida Area, India',
    summary: 'Client servicing and documentation work for DGFT submissions in the SIES department.',
    bullets: ['Prepared client documents and supported DGFT submission workflows.'],
  },
];

const education = [
  { school: 'York University', credential: 'Postgraduate - Digital and Content Marketing', period: 'September 2025 - May 2026', logo: '/logos/education/york-university.jpg', logoClass: 'max-h-10 max-w-[9rem]' },
  { school: 'George Brown College', credential: 'Postgraduate - Marketing Management, Digital Media', period: 'May 2024 - April 2025', logo: '/logos/education/george-brown-college.svg', logoClass: 'max-h-11 max-w-[9rem]' },
  { school: 'Mahatma Gandhi Chitrakoot Gramodaya Vishwavidyalaya', credential: 'Bachelor of Commerce - Marketing', period: '2015 - 2018', logo: '/logos/education/mgcgv.png', logoClass: 'max-h-12 max-w-[3rem]' },
  { school: 'Gwalior Glory High School', credential: 'Commerce and Maths', period: '2013 - 2015', logo: '/logos/education/gwalior-glory.png', logoClass: 'max-h-10 max-w-[9rem]' },
  { school: 'The Scindia School', credential: 'High School', period: '2010 - 2013', logo: '/logos/education/scindia-school.png', logoClass: 'max-h-10 max-w-[9rem]' },
];

const skills = [
  'Performance marketing',
  'E-commerce growth',
  'Meta ads',
  'Google Ads',
  'TikTok marketing',
  'Shopify funnels',
  'Creative testing',
  'Conversion analysis',
  'Marketing automation',
  'WhatsApp API funnels',
  'AI agent workflows',
  'React app collaboration',
  'Cloudflare deployment',
  'Data-led growth loops',
];

const certifications = ['HubSpot Marketing Hub Software', 'CannSell Standard Certification', 'Instagram Unchained - Latest Instagram Marketing Hacks', 'Digital Marketing'];
const languages = ['English - full professional', 'Hindi - native or bilingual'];

const systems = [
  { name: 'Glitch Executor', type: 'Prop-trading dashboard · live', detail: 'Track your prop-firm challenges and build + test strategies — one dashboard for every connected account, with a strategy builder and a backtester that\'s aware of every firm\'s rule set. I own the product, the build, and the deployment: React front end, Python services, Cloudflare + GCP infra.', proof: 'Live · glitchexecutor.com', href: 'https://glitchexecutor.com' },
  { name: 'Mesh Pilot', type: 'Open agent mesh · live', detail: 'Six specialist AI agents (voice, SEO, ads, sales, social, UGC) coordinated by an orchestration layer. The agents are open-source; the coordination brain is the product. Built and shipped end to end.', proof: 'Live · meshpilot.app', href: 'https://meshpilot.app' },
  { name: 'Autonomous ads agent', type: 'What "shipped AI" actually means', detail: 'Reads live performance across Meta, Google, and Amazon, generates optimization proposals, surfaces them to me on Discord for approval, then executes the approved changes through official APIs — with a full audit trail. Runs against real spend, daily.', proof: 'HITL · multi-platform · in production', href: 'https://meshpilot.app' },
];
---
<Base
  pageType="AboutPage"
  title="Performance marketer who ships AI products"
  description="Tejas Karan Agrawal — performance marketer who, in 90 days, went from shipping Shopify stores to shipping two production AI products (Glitch Executor, Mesh Pilot). The rare hire who owns the growth loop and builds the systems under it."
>
  <section class="relative overflow-hidden pt-8 pb-10 md:pt-10 md:pb-14">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-[-18rem] h-[48rem] w-[78rem] max-w-[115vw] -translate-x-1/2 rounded-full bg-[radial-gradient(circle_at_center,rgb(var(--color-brand)/0.18),transparent_62%)] blur-3xl"></div>
      <div class="absolute right-[-10rem] top-40 h-[32rem] w-[32rem] rounded-full bg-[radial-gradient(circle_at_center,rgb(var(--color-electric)/0.14),transparent_62%)] blur-3xl"></div>
    </div>
    <div class="container-app grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="min-w-0 lg:col-span-7 reveal">
        <p class="font-mono text-fluid-xs uppercase tracking-wider text-brand">Performance marketer · now shipping production AI</p>
        <h1 class="mt-4 text-fluid-5xl font-bold leading-[0.92] tracking-tighter md:text-fluid-6xl">Tejas Karan<br /><span class="gradient-text">Agrawal</span></h1>
        <p class="mt-7 max-w-[60ch] text-fluid-lg text-muted">Three months ago the most I could ship was a Shopify store. Today two AI products I built — <a href="https://glitchexecutor.com" class="text-fg underline decoration-brand/40 hover:decoration-brand">Glitch Executor</a> and <a href="https://meshpilot.app" class="text-fg underline decoration-brand/40 hover:decoration-brand">Mesh Pilot</a> — run in production.</p>
        <p class="mt-4 max-w-[60ch] text-fluid-base text-muted">That's the hire: someone who owns the full growth loop <em class="not-italic text-fg">and</em> builds the systems underneath it. Most marketers stop at the dashboard — I ship what's behind it.</p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="#contact" class="btn btn-primary px-6 py-3.5 text-fluid-base">Talk about a role</a>
          <a href="#arc" class="btn btn-ghost text-fluid-base">See the 90-day arc</a>
        </div>
        <p class="mt-4 text-fluid-xs text-subtle">Toronto, Ontario · performance marketing, e-commerce growth, Shopify, paid media, AI agents.</p>
      </div>
      <div class="order-3 min-w-0 lg:order-none lg:col-span-5 reveal lg:self-center">
        <div class="card relative overflow-hidden p-3">
          <img class="aspect-video w-full rounded-lg object-cover" src="/hero/shopify-dashboard.jpg" alt="Shopify admin dashboard for a store I operate — 50.7K sessions, ₹1.31M total sales, 1,559 orders year-to-date" width="2560" height="1440" loading="eager" decoding="async" />
          <div class="grid gap-3 p-4">
            <div class="flex items-center justify-between border-b border-border/60 pb-3 font-mono text-fluid-xs text-muted"><span>live store I operate</span><span class="text-brand">₹1.3M · 1,559 orders</span></div>
            <div class="grid gap-2 text-fluid-sm text-muted">
              <span>This dashboard is real growth work — the kind I've done for years.</span>
              <span class="text-brand">The two apps below are the new part: software I now build and ship myself.</span>
            </div>
          </div>
        </div>
      </div>
      <div class="order-2 min-w-0 lg:order-none lg:col-span-12">
        <StackLogoMarquee />
      </div>
    </div>
  </section>

  <section id="proof" class="border-y border-border/60 bg-surface/35 py-6">
    <div class="container-app grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {proof.map((item) => (
        <div class="min-h-[126px] border-l border-border/60 py-2 pl-4">
          <p class="text-fluid-4xl font-bold tracking-tight text-brand">{item.value}</p>
          <p class="mt-2 text-fluid-sm text-muted">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="arc" class="py-12 md:py-16">
    <div class="container-app">
      <div class="max-w-3xl">
        <p class="eyebrow">The 90-day arc</p>
        <h2 class="mt-4">From a Shopify store to two products in production.</h2>
        <p class="mt-4 text-fluid-lg text-muted">The interesting thing isn't where I started — it's how fast the ceiling moved. In about three months I went from "the most I can ship is a storefront" to operating two live AI products. Here's the actual progression.</p>
      </div>
      <ol class="mt-12 grid gap-4 md:grid-cols-3">
        <li class="card relative p-6">
          <span class="font-mono text-fluid-xs text-subtle">01 · early 2026</span>
          <h3 class="mt-3 text-fluid-xl">The ceiling was a storefront</h3>
          <p class="mt-3 text-fluid-sm text-muted">Years of real growth results — paid social, four Shopify stores, ₹2cr+ in sales. But anything technical past the store needed a developer. I could direct the work; I couldn't build it.</p>
        </li>
        <li class="card relative p-6">
          <span class="font-mono text-fluid-xs text-brand">02 · the shift</span>
          <h3 class="mt-3 text-fluid-xl">I turned AI into a build team</h3>
          <p class="mt-3 text-fluid-sm text-muted">Instead of using AI to advise, I started using it to <em class="not-italic text-fg">build</em> — two models working as a team, one to reason through the architecture and one to write the code, with me holding the product and the context. The bottleneck stopped being "can I code."</p>
        </li>
        <li class="card relative p-6">
          <span class="font-mono text-fluid-xs text-brand">03 · now</span>
          <h3 class="mt-3 text-fluid-xl">Two apps live in production</h3>
          <p class="mt-3 text-fluid-sm text-muted">Glitch Executor and Mesh Pilot are deployed — real infrastructure, autonomous agents, an ads agent I use daily. Not prototypes; software running against real accounts and real money.</p>
        </li>
      </ol>
      <p class="mt-8 max-w-3xl text-fluid-base text-muted">Why it matters for a hire: I'm not a marketer who <em class="not-italic text-fg">talks</em> about AI, and I'm not an engineer who's never run a campaign. I'm the rare middle — someone who owns the growth loop and can ship the systems beneath it, fast.</p>
    </div>
  </section>

  <section id="systems" class="py-12 md:py-16">
    <div class="container-app">
      <div class="max-w-3xl">
        <h2>What I shipped.</h2>
        <p class="mt-4 text-fluid-lg text-muted">Not concepts or courses — deployed software running against real accounts. I'm not pitching for an engineering seat; these are proof that when I say I'll build the system behind the campaign, I actually ship it.</p>
      </div>
      <div class="mt-10 grid gap-4">
        {systems.map((system, idx) => (
          <a href={system.href} class="card grid gap-5 p-5 transition-transform hover:-translate-y-0.5 md:grid-cols-[0.12fr_0.28fr_1fr_0.18fr] md:items-center md:p-6">
            <div class="font-mono text-fluid-sm text-brand">0{idx + 1}</div>
            <div><h3 class="text-fluid-2xl">{system.name}</h3><p class="mt-1 text-fluid-sm text-subtle">{system.type}</p></div>
            <p class="text-fluid-base text-muted">{system.detail}</p>
            <p class="font-mono text-fluid-xs uppercase tracking-wider text-subtle md:text-right">{system.proof}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="experience" class="border-y border-border/60 bg-surface/35 py-12 md:py-16">
    <div class="container-app">
      <div class="max-w-3xl">
        <h2>The path.</h2>
        <p class="mt-4 text-fluid-lg text-muted">My story is not a straight resume line. It is a progression: self-taught digital marketing, early jobs, formal study in Canada, e-commerce proof, brand-facing performance work, and now AI-first marketing automation.</p>
      </div>
      <div class="mt-10 grid gap-4">
        {experience.map((item, idx) => (
          <article class="card grid gap-5 p-5 md:grid-cols-[0.12fr_0.28fr_1fr] md:p-6">
            <div class="font-mono text-fluid-sm text-brand">{String(idx + 1).padStart(2, '0')}</div>
            <div>
              <h3 class="text-fluid-2xl">{item.role}</h3>
              <p class="mt-1 text-fluid-base text-fg">{item.org}</p>
              <p class="mt-2 font-mono text-fluid-xs uppercase tracking-wider text-subtle">{item.period}</p>
              <p class="mt-1 text-fluid-sm text-subtle">{item.place}</p>
            </div>
            <div>
              <p class="text-fluid-base text-muted">{item.summary}</p>
              <ul class="mt-4 grid gap-2 text-fluid-sm text-muted">
                {item.bullets.map((bullet) => <li class="border-l border-brand/40 pl-3">{bullet}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="education" class="py-12 md:py-16">
    <div class="container-app grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2>Education that sharpened the execution.</h2>
        <p class="mt-4 text-fluid-lg text-muted">I moved to Canada because I wanted to deepen what I had already been practicing since 2018. The diplomas gave structure to the hands-on learning I had built through jobs, stores, campaigns, and side projects.</p>
      </div>
      <div class="grid gap-8 lg:col-span-7">
        <div class="grid gap-3">
          {education.map((item) => (
            <article class="card grid gap-4 p-5 sm:grid-cols-[auto_1fr_auto] sm:items-center">
              <div class="flex h-16 w-40 shrink-0 items-center justify-center rounded-lg border border-border/70 bg-white p-3">
                <img src={item.logo} alt={`${item.school} logo`} width="128" height="64" loading="lazy" decoding="async" class:list={[item.logoClass, 'h-auto w-auto object-contain']} />
              </div>
              <div><h3 class="text-fluid-xl">{item.school}</h3><p class="mt-2 text-fluid-sm text-muted">{item.credential}</p></div>
              <p class="font-mono text-fluid-xs uppercase tracking-wider text-subtle sm:text-right">{item.period}</p>
            </article>
          ))}
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <article class="card p-5"><h3 class="text-fluid-xl">Certifications</h3><div class="mt-4 flex flex-wrap gap-2">{certifications.map((item) => <span class="rounded-full border border-border bg-surface-2 px-3 py-1 text-fluid-xs text-muted">{item}</span>)}</div></article>
          <article class="card p-5"><h3 class="text-fluid-xl">Languages</h3><div class="mt-4 flex flex-wrap gap-2">{languages.map((item) => <span class="rounded-full border border-border bg-surface-2 px-3 py-1 text-fluid-xs text-muted">{item}</span>)}</div></article>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="border-y border-border/60 bg-surface/35 py-12 md:py-16">
    <div class="container-app grid gap-8 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-4"><h2>What I can plug into.</h2><p class="mt-4 text-fluid-lg text-muted">The stack is marketing-first, but automation-aware: paid media, e-commerce, creative testing, analytics thinking, and enough technical fluency to work with modern AI-first teams.</p></div>
      <div class="flex flex-wrap gap-3 lg:col-span-8">
        {skills.map((skill) => <span class="rounded-full border border-border bg-bg/60 px-4 py-2 text-fluid-sm text-muted">{skill}</span>)}
      </div>
    </div>
  </section>

  <section id="contact" class="pb-16 md:pb-24">
    <div class="container-app">
      <div class="card relative overflow-hidden p-6 md:p-10">
        <div aria-hidden="true" class="absolute right-[-8rem] top-[-8rem] h-[24rem] w-[24rem] rounded-full bg-[radial-gradient(circle_at_center,rgb(var(--color-brand)/0.16),transparent_62%)] blur-3xl"></div>
        <div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h2>Hiring for an AI-first growth operator?</h2>
            <p class="mt-4 max-w-2xl text-fluid-lg text-muted">I am looking for performance marketing, digital marketing, e-commerce growth, and marketing automation roles where hands-on execution matters and AI-first thinking is an advantage.</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
            <a href={`mailto:${site.contactEmail}?subject=Performance%20marketing%20role%20for%20Tejas`} class="btn btn-primary justify-center px-6 py-3.5">Talk about a role</a>
            <a href={site.linkedin} target="_blank" rel="noreferrer" class="btn btn-ghost justify-center px-6 py-3.5">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
