---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/sections/Hero.astro';
import SaasVsOwnership from '~/components/sections/SaasVsOwnership.astro';
import TwoPaths from '~/components/sections/TwoPaths.astro';
import HowItWorks from '~/components/sections/HowItWorks.astro';
import AgentsCatalog from '~/components/sections/AgentsCatalog.astro';
import ResellerMath from '~/components/sections/ResellerMath.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import KitPricing from '~/components/sections/KitPricing.astro';
import FAQ from '~/components/sections/FAQ.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import KitCtaStrip from '~/components/sections/KitCtaStrip.astro';
---

<!--
  Sequence reads as a story, with kit-conversion CTAs threaded between
  every major payoff so scroll-bouncers always have a button in view:

   Hero
   SaasVsOwnership   — the shift
   TwoPaths          — persona match
   ┃ KitCtaStrip · outline
   HowItWorks
   AgentsCatalog     — product
   ┃ KitCtaStrip · solid
   ResellerMath      — money
   Testimonials      — social proof
   ┃ KitCtaStrip · outline
   KitPricing        — the close
   FAQ
   CallToAction
-->
<Base pageType="WebPage" ogSlug="home">
  <Hero />
  <SaasVsOwnership />
  <TwoPaths />
  <KitCtaStrip
    id="kit-strip-1"
    variant="outline"
    headline="Match found. Grab the kit before you keep reading."
    subhead="The free Vibe Coder Kit installs into Claude Code, Codex, Cursor, OpenClaw — any AI coding agent — in under a minute. Required before you deploy any of our paid agents."
  />
  <HowItWorks />
  <AgentsCatalog />
  <KitCtaStrip
    id="kit-strip-2"
    variant="solid"
    headline="Six agents. One stack. Free kit gets you ready in 60 seconds."
    subhead="The kit pre-wires every MCP and skill the paid agents expect. Skip it and your install is twice as long."
  />
  <ResellerMath />
  <Testimonials />
  <KitCtaStrip
    id="kit-strip-3"
    variant="outline"
    headline="Convinced? Start with the free kit."
    subhead="Yours to keep. No card. No subscription. Required for the $499 Stack."
  />
  <KitPricing />
  <FAQ />
  <CallToAction />
</Base>
