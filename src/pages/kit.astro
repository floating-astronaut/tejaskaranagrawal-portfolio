---
// Identical to /. Lives at /kit so cold ads can target a clean URL,
// `/kit?utm_source=meta&utm_campaign=...`, without polluting the homepage's
// referrer logs. Both URLs render the same component tree.
import Base from '~/layouts/Base.astro';
import Hero from '~/components/sections/Hero.astro';
import SaasVsOwnership from '~/components/sections/SaasVsOwnership.astro';
import HowItWorks from '~/components/sections/HowItWorks.astro';
import AgentsCatalog from '~/components/sections/AgentsCatalog.astro';
import ResellerMath from '~/components/sections/ResellerMath.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import KitPricing from '~/components/sections/KitPricing.astro';
import FAQ from '~/components/sections/FAQ.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
---

<Base pageType="WebPage" ogSlug="home">
  <Hero />
  <SaasVsOwnership />
  <HowItWorks />
  <AgentsCatalog />
  <ResellerMath />
  <Testimonials />
  <KitPricing />
  <FAQ />
  <CallToAction />
</Base>
