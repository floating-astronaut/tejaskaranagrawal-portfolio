---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { site, legalEntity } from '~/lib/site';
const entity = legalEntity;
---

<Base
  title="Contact Us"
  description={`Contact ${entity.name} for support, refund requests, partnerships, or media.`}
  pageType="WebPage"
  noindex={false}
>
  <section class="container-app py-20 max-w-prose-tight">
    <p class="eyebrow">Legal · Global</p>
    <h1 class="mt-4">Contact us</h1>

    <div class="prose mt-10 text-muted [&_h2]:text-fg [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-fluid-xl [&_p]:my-3 [&_strong]:text-fg [&_a]:text-brand">

      <h2>Merchant of record</h2>
      <p>
        <strong>{entity.name}</strong>
        <br/>
        {entity.type}, owned by <strong>{entity.owner}</strong>
        <br/>
        {entity.address}
      </p>

      <h2>Email</h2>
      <p>
        For all enquiries — sales, support, refunds, partnership,
        media — write to:
      </p>
      <p>
        <a class="inline-flex items-center gap-2 font-mono text-fluid-base"
           href={`mailto:${entity.email}`}>
          {entity.email}
          <Icon name="arrow-up-right" size={14} />
        </a>
      </p>
      <p class="text-fluid-sm">
        We aim to respond within <strong>1 business day</strong> for
        product / sales / refund queries, and within <strong>30 days</strong>
        for privacy and data-related queries (consistent with
        PIPEDA &amp; GDPR response timelines).
      </p>

      <h2>Privacy &amp; data requests</h2>
      <p>
        Requests under PIPEDA, GDPR, the UK Data Protection Act
        2018, the CCPA / CPRA, or any other applicable privacy
        regime — for access, correction, deletion, portability, or
        consent withdrawal — should be sent to the same address with
        the subject line <strong>"Privacy request"</strong>. The full
        rights-and-process matrix is in our
        <a href="/legal/privacy">Privacy Policy</a>.
      </p>

      <h2>Payments &amp; chargebacks</h2>
      <p>
        Payments are processed by <strong>Stripe Payments Canada
        Ltd.</strong> on the global variant. For payment-instrument
        disputes, please contact us first; if the matter cannot be
        resolved, You may approach Stripe directly via
        <a href="https://support.stripe.com/" target="_blank" rel="noopener"> support.stripe.com</a>
        or Your card-issuing bank.
      </p>

      <h2>Community &amp; informal support</h2>
      <p>
        For non-formal product / kit / technical questions, the
        fastest channel is our Discord:
        <a href="https://discord.gg/HBZFKMts" target="_blank" rel="noopener"> discord.gg/HBZFKMts</a>.
        Discord is informal and best-effort — for anything
        contractual, billing-related, or grievance-status, please
        use email so we have a written record.
      </p>

      <h2>India users</h2>
      <p>
        If You are based in India and were directed here from
        <code>{site.domain}/in/</code>, please use the India contact
        page (<a href="/in/legal/contact">/in/legal/contact</a>) —
        it lists Bani Thani as the local merchant of record, the
        Grievance Officer per IT Rules 2021, and Razorpay grievance
        contacts.
      </p>

      <h2>Related policies</h2>
      <p>
        <a href="/legal/terms">Terms of Service</a>
        &nbsp;·&nbsp;
        <a href="/legal/privacy">Privacy Policy</a>
        &nbsp;·&nbsp;
        <a href="/legal/refund">Cancellation &amp; Refund</a>
        &nbsp;·&nbsp;
        <a href="/legal/shipping">Shipping &amp; Exchange</a>
      </p>
    </div>
  </section>
</Base>
