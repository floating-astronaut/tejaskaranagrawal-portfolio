---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import { competitors } from '~/data/pseo-matrix';
import fs from 'node:fs';
import path from 'node:path';

// Load snapshots at build time from scripts/pricing-snapshots/<slug>.json.
// Each snapshot is produced by scripts/pricing-watcher.ts (weekly cron),
// committed back to the repo. This page is the public render — a
// canonical citation target for "Zapier pricing history" / "n8n pricing
// history" queries.
interface Snapshot {
  url: string;
  fetchedAt: string;
  hash: string;
  priceExcerpts: string[];
}

const SNAP_DIR = path.join(process.cwd(), 'scripts', 'pricing-snapshots');

interface CompetitorEntry {
  slug: string;
  name: string;
  url: string;
  snapshot: Snapshot | null;
  hasSnapshot: boolean;
}

const entries: CompetitorEntry[] = competitors.map((c) => {
  const file = path.join(SNAP_DIR, `${c.slug}.json`);
  let snapshot: Snapshot | null = null;
  if (fs.existsSync(file)) {
    try { snapshot = JSON.parse(fs.readFileSync(file, 'utf8')); } catch { /* ignore */ }
  }
  return { slug: c.slug, name: c.name, url: c.url, snapshot, hasSnapshot: snapshot !== null };
});

const tracked = entries.filter((e) => e.hasSnapshot);
const pending = entries.filter((e) => !e.hasSnapshot);

const fmtDate = (s: string) => new Date(s).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const faqs = [
  {
    q: 'How is pricing data collected?',
    a: 'A weekly cron job fetches each competitor\'s published pricing page, normalizes the HTML (strips scripts, styles, asset hashes), and snapshots the result. When a page changes from the previous snapshot, the script opens a GitHub issue so we refresh the affected /alternatives and /vs pages.',
  },
  {
    q: 'How often does pricing change?',
    a: 'Workflow tools (Zapier, Make, n8n) usually update annually; per-minute voice platforms (Vapi, Retell, Bland) can shift more often. The hash detection catches both substantive price changes and the cosmetic copy refreshes that often happen alongside them.',
  },
  {
    q: 'Why is this public?',
    a: 'Buyers comparing tools deserve a single source of truth on what each tool actually charges. Most competitor pricing pages get redesigned every quarter; the snapshot trail makes the historical record explicit.',
  },
  {
    q: 'Is this an official source?',
    a: 'No — the canonical source is each competitor\'s pricing page (linked under "Live page" for each row). This page records what we observed at each snapshot. If you see a discrepancy with the live page, the live page is right.',
  },
];

const lastUpdate = tracked.length
  ? tracked.reduce((latest, e) => {
      const t = e.snapshot?.fetchedAt;
      return t && t > latest ? t : latest;
    }, '0000')
  : null;
---

<Base
  title="Competitor pricing history — Glitch Grow"
  description="Public snapshot history of AI agent & automation tool pricing — Zapier, Make, n8n, Vapi, Retell, Smartlead, Instantly, Manychat, Gumloop, Lindy, Relevance, Stack AI. Updated weekly via automated fetch."
  pageType="WebPage"
>
  <Fragment slot="head">
    <FAQSchema faqs={faqs} />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Pricing history', url: '/pricing-history' },
    ]} />
  </Fragment>

  <article class="container-app pt-14 pb-24 md:pt-20">
    <header class="max-w-3xl">
      <p class="eyebrow"><Icon name="chart" size={14} /> Pricing history</p>
      <h1 class="mt-4">Competitor pricing history.</h1>
      <p class="mt-5 text-fluid-lg text-muted">
        Automated weekly snapshots of every AI agent / automation tool's published pricing page. Hash on change, diff on update, public record of what each tool charged when.
      </p>
      {lastUpdate && (
        <p class="mt-2 text-fluid-xs text-subtle">
          Most recent snapshot fetched <time datetime={lastUpdate}>{fmtDate(lastUpdate)}</time>.
        </p>
      )}
    </header>

    {tracked.length > 0 && (
      <section class="mt-12">
        <h2 class="text-fluid-2xl">Tracked competitors</h2>
        <ul class="mt-5 space-y-6" role="list">
          {tracked.map((e) => (
            <li class="card p-6">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <div>
                  <h3 class="text-fluid-lg font-medium">{e.name}</h3>
                  <p class="mt-1 text-fluid-xs text-subtle">
                    Last snapshot: <time datetime={e.snapshot!.fetchedAt}>{fmtDate(e.snapshot!.fetchedAt)}</time> · hash <code class="font-mono">{e.snapshot!.hash}</code>
                  </p>
                </div>
                <div class="flex gap-3 text-fluid-sm">
                  <a href={`/alternatives/${e.slug}`} class="text-brand hover:underline">Comparison</a>
                  <span class="text-subtle">·</span>
                  <a href={e.snapshot!.url} target="_blank" rel="noopener noreferrer" class="text-brand hover:underline">
                    Live page <Icon name="arrow-up-right" size={11} />
                  </a>
                </div>
              </div>
              {e.snapshot!.priceExcerpts.length > 0 && (
                <div class="mt-4 pt-4 border-t border-border/40">
                  <p class="label-ui">Prices captured</p>
                  <ul class="mt-3 flex flex-wrap gap-2" role="list">
                    {e.snapshot!.priceExcerpts.slice(0, 24).map((p) => (
                      <li class="font-mono text-fluid-xs px-2 py-0.5 rounded border border-border/60 text-fg/85">{p}</li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {pending.length > 0 && (
      <section class="mt-12">
        <h2 class="text-fluid-2xl">Awaiting first snapshot</h2>
        <p class="mt-3 text-muted text-fluid-sm leading-relaxed max-w-3xl">
          Snapshots populate weekly via the pricing-watcher cron. Tools below are tracked but haven't been captured yet — first capture lands at the next cron run.
        </p>
        <ul class="mt-5 grid gap-3 md:grid-cols-2 lg:grid-cols-3" role="list">
          {pending.map((e) => (
            <li class="card p-4">
              <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">awaiting</p>
              <p class="mt-1 text-fluid-base font-medium">{e.name}</p>
              <a href={`/alternatives/${e.slug}`} class="mt-2 inline-block text-fluid-xs text-brand hover:underline">
                See comparison →
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-16 max-w-3xl">
      <h2 class="text-fluid-2xl">How this works</h2>
      <ol class="mt-5 space-y-3 text-fluid-base text-fg/90 leading-relaxed list-decimal pl-6">
        <li>
          Every Monday at 06:00 UTC, <code class="font-mono text-fluid-sm text-brand">scripts/pricing-watcher.ts</code> fetches the configured pricing URL for each competitor.
        </li>
        <li>
          The HTML is normalized — scripts, styles, asset hashes, comments, and whitespace stripped — leaving just visible text.
        </li>
        <li>
          A SHA-256 hash of the normalized text becomes the snapshot's fingerprint. Price-shaped tokens (e.g., <code class="font-mono text-fluid-sm">$19.99/mo</code>) are extracted for diffing.
        </li>
        <li>
          If the hash differs from the previous snapshot, a GitHub issue opens with the diff so the affected <a href="/alternatives" class="text-brand underline">/alternatives</a> and <a href="/vs" class="text-brand underline">/vs</a> pages get refreshed.
        </li>
        <li>
          The new snapshot replaces the old, and this page rebuilds at the next deploy.
        </li>
      </ol>
    </section>

    <section class="mt-14 max-w-3xl">
      <h2 class="text-fluid-2xl">Frequently asked questions</h2>
      <ul class="mt-5 divide-y divide-border/60 border-y border-border/60" role="list">
        {faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none">
                <span class="text-fluid-base font-medium pr-2">{f.q}</span>
                <span aria-hidden="true" class="shrink-0 mt-1 size-6 inline-flex items-center justify-center rounded-full border border-border text-subtle transition-transform group-open:rotate-45 group-open:text-brand">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </span>
              </summary>
              <p class="pb-5 pr-8 text-fluid-sm text-muted leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Base>
