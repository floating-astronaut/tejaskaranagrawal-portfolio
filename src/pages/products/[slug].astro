---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import YouTubeEmbed from '~/components/YouTubeEmbed.astro';
import SoftwareApplicationSchema from '~/components/schema/SoftwareApplicationSchema.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import { products, type Product } from '~/lib/products';
import { bundles, bundleDiscountPct } from '~/lib/bundles';

const founderStack = bundles[0];
const founderStackDiscount = bundleDiscountPct(founderStack);

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props { product: Product; }
const { product } = Astro.props;

// Detail pages are pre-rendered (output: 'static') so we can't read
// CF-IPCountry at request time. SSR-mode would let us, but switching
// the whole site to hybrid is too big a change for a same-day launch.
//
// Compromise: render USD by default, then swap to INR client-side via
// a fetch to /cdn-cgi/trace (Cloudflare exposes the visitor's `loc=`
// country code there for free, no extra service). The swap targets
// data-geo-* attributes — see the inline script at the bottom of this
// file.
const usdLabel = '$' + product.priceUsd.toLocaleString('en-US');
const inrLabel = '₹' + product.priceInr.toLocaleString('en-IN');
const sellAs = product.sellAs;
const useCases = product.derivativeUseCases;

const statusLabel: Record<Product['status'], string> = {
  shipped: 'Ship-ready',
  'in-pilot': 'In pilot',
  'coming-soon': 'Coming soon',
};

// Show 2 sibling products at the bottom for navigation, using the new
// scannable card surface (chip + metric grid) instead of the old
// "name + tagline blob" pattern.
const siblings = products.filter((p) => p.slug !== product.slug).slice(0, 2);
---

<Base
  title={product.name}
  description={product.oneLiner}
  pageType="WebPage"
  ogSlug={`product-${product.slug}`}
>
  <Fragment slot="head">
    <SoftwareApplicationSchema
      name={product.name}
      description={`${product.tagline} ${product.subline}`}
      url={`/products/${product.slug}`}
      price={product.priceUsd}
      priceCurrency="USD"
      offerUrl={product.buyUrl}
      applicationCategory="BusinessApplication"
      featureList={product.capabilities}
    />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Products', url: '/products' },
      { name: product.name, url: `/products/${product.slug}` },
    ]} />
  </Fragment>
  <article class="container-app py-10 md:py-14 lg:py-16">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/products" class="hover:text-fg">Catalog</a>
      <span class="mx-1">/</span>
      <span class="text-muted">{product.name}</span>
    </nav>

    {/* HEADER — same scannable surface as the homepage card.
        Identity → one-liner → chips → metrics, then a buy box on
        the right with price + the two CTAs (Buy + browse public repo). */}
    <header class="mt-6 grid gap-8 lg:grid-cols-12 items-start">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 flex-wrap">
          <span class="inline-flex size-12 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
            <Icon name={product.icon} size={22} />
          </span>
          <span class="code-tag">{product.sku}</span>
          <span class={`text-[0.7rem] font-medium tracking-[-0.005em] px-2 py-0.5 rounded-md border ${
            product.status === 'shipped'
              ? 'border-brand/40 text-brand'
              : product.status === 'in-pilot'
                ? 'border-electric/40 text-electric'
                : 'border-border text-subtle'
          }`}>
            {statusLabel[product.status]}
          </span>
        </div>
        <h1 class="mt-5">{product.name}</h1>
        <p class="mt-2 label-ui text-brand text-[0.8rem]">{product.productLine}</p>
        <p class="mt-5 lede max-w-prose">{product.oneLiner}</p>

        <ul class="mt-6 flex flex-wrap gap-1.5" role="list" aria-label="Capabilities">
          {product.chips.map((c) => <li><span class="chip">{c}</span></li>)}
        </ul>

        <dl class="mt-6 grid grid-cols-2 gap-5 max-w-md">
          <div>
            <dt class="label-ui">Deploy</dt>
            <dd class="mt-1 text-fluid-base font-medium num">{product.metrics.deploy}</dd>
          </div>
          <div>
            <dt class="label-ui">Sell</dt>
            <dd class="mt-1 text-fluid-base font-medium num">{product.metrics.sell}</dd>
          </div>
        </dl>
      </div>

      {/* BUY BOX — sticky on lg+ so it stays visible while the buyer
          scrolls the spec content below. */}
      <aside class="lg:col-span-5 lg:sticky lg:top-[calc(var(--header-stack-h,7rem)+1rem)]">
        <div class="card p-6 md:p-7">
          <p class="label-ui">One-time · Lifetime updates · 14-day refund</p>
          {/* Default USD render; the inline script at the bottom flips the
              text + button rail for IN visitors after /cdn-cgi/trace resolves. */}
          <p
            class="mt-2 num-mono text-fluid-4xl text-brand leading-none font-medium"
            data-geo-price
            data-usd={usdLabel}
            data-inr={inrLabel}
          >{usdLabel}</p>
          <p
            class="mt-2 text-fluid-xs text-subtle leading-relaxed"
            data-geo-priceline
            data-usd={product.priceLine}
            data-inr={`${product.priceLine} · GST inclusive · paid via Razorpay`}
          >{product.priceLine}</p>

          {/* Two CTAs: the Stripe redirect (default visible) + the Razorpay
              trigger (hidden by default, swapped in for IN). Each carries
              its own data-* trigger attributes so TikTokFunnel + Razorpay
              modal pick up the right rail. When buyUrl is empty (Stripe
              Payment Link not yet provisioned), render a "Notify me" CTA
              wired to the lead modal so the page never renders a dead Buy. */}
          {product.buyUrl ? (
            <a
              href={product.buyUrl}
              class="mt-5 btn btn-primary w-full justify-center text-fluid-base py-3.5"
              data-sku={product.sku}
              data-price-major={String(product.priceUsd)}
              data-currency="USD"
              data-geo-cta="us"
            >
              Buy {product.sku}
              <Icon name="arrow-right" size={16} />
            </a>
          ) : (
            <button
              type="button"
              class="mt-5 btn btn-secondary w-full justify-center text-fluid-base py-3.5"
              data-cta="kit"
              data-notify-sku={product.sku}
              data-geo-cta="us"
              aria-label={`Get notified when ${product.name} checkout is live`}
            >
              Notify me when ready
              <Icon name="arrow-right" size={16} />
            </button>
          )}
          <button
            type="button"
            class="mt-5 btn btn-primary w-full justify-center text-fluid-base py-3.5 hidden"
            data-razorpay-sku={product.sku}
            data-price-major={String(product.priceInr)}
            data-currency="INR"
            data-geo-cta="in"
            aria-label={`Buy ${product.name} for ${inrLabel}`}
          >
            Buy {product.sku}
            <Icon name="arrow-right" size={16} />
          </button>
          <a
            href={product.publicRepo}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-link w-full justify-center mt-2"
          >
            Browse public repo
            <Icon name="arrow-up-right" size={14} />
          </a>

          <p class="mt-4 text-fluid-xs text-subtle leading-snug">
            On purchase you become a collaborator on the
            <strong class="text-fg/80">private</strong> GitHub repo —
            full source, brand-config schema, deploy/, playbook PDF.
          </p>
        </div>
      </aside>
    </header>

    {/* DEMO VIDEO — facade-loaded so the YouTube player JS doesn't
        block LCP. Only renders when the SKU has a recorded demo. */}
    {product.demoVideoId && (
      <section id="demo" class="mt-12 max-w-4xl scroll-mt-24" aria-label="Agent demo">
        <YouTubeEmbed
          id={product.demoVideoId}
          title={product.demoVideoTitle ?? `${product.name} demo`}
          caption="Agent in action — 2 min"
        />
      </section>
    )}

    {/* SPEC TABS — same 4-tab structure as the homepage card drawer,
        but expanded to the full content surface here. CSS-only via
        radio + :has() in global.css. */}
    <section class="mt-12 max-w-3xl">
      <p class="eyebrow"><Icon name="layers" size={14} /> Spec</p>
      <h2 class="mt-3 text-fluid-2xl">Inside the kit</h2>

      <div class="tab-group mt-6">
        <input class="tab-input--includes" type="radio" id={`spec-${product.slug}-includes`} name={`spec-${product.slug}`} checked />
        <input class="tab-input--usecase"  type="radio" id={`spec-${product.slug}-usecase`}  name={`spec-${product.slug}`} />
        <input class="tab-input--resell"   type="radio" id={`spec-${product.slug}-resell`}   name={`spec-${product.slug}`} />
        <input class="tab-input--needs"    type="radio" id={`spec-${product.slug}-needs`}    name={`spec-${product.slug}`} />
        <div class="tab-list">
          <label for={`spec-${product.slug}-includes`} data-tab-label="includes">Includes</label>
          <label for={`spec-${product.slug}-usecase`}  data-tab-label="usecase">Use case</label>
          <label for={`spec-${product.slug}-resell`}   data-tab-label="resell">Resell</label>
          <label for={`spec-${product.slug}-needs`}    data-tab-label="needs">Needs</label>
        </div>

        {/* INCLUDES — full capabilities list, compact 2-column at md+. */}
        <div data-tab="includes">
          <ul class="grid gap-2 md:grid-cols-2" role="list">
            {product.capabilities.map((c) => (
              <li class="flex items-start gap-2.5 text-fluid-sm text-fg/90 leading-snug">
                <span class="mt-[5px] text-brand shrink-0"><Icon name="check" size={14} /></span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* USE CASE — bestFor lead-line + derivativeUseCases as 3 cards. */}
        <div data-tab="usecase">
          <p class="text-fluid-base text-fg/90 leading-snug">{product.bestFor}</p>
          <ul class="mt-5 grid gap-3 md:grid-cols-3" role="list">
            {useCases.slice(0, 3).map((u) => (
              <li class="card p-4 text-fluid-sm text-fg/90 leading-snug">{u}</li>
            ))}
          </ul>
        </div>

        {/* RESELL — sellAs + a one-line license note. */}
        <div data-tab="resell">
          <p class="text-fluid-base text-fg/90 leading-snug">{sellAs}</p>
          <p class="mt-4 text-fluid-sm text-subtle leading-snug">
            BSL 1.1 — modify, deploy, deliver derivatives to your clients.
            Cannot repackage as a competing kit.
          </p>
        </div>

        {/* NEEDS — single line plus a "we ship" reassurance row. */}
        <div data-tab="needs">
          <p class="text-fluid-base text-fg/90 leading-snug">{product.requirements}</p>
          <p class="mt-4 text-fluid-sm text-subtle leading-snug">
            Deploy recipes ship for systemd · nginx · GCE cloud-init ·
            Cloud Run YAML · Docker. Pick your stack.
          </p>
        </div>
      </div>
    </section>

    {/* FOUNDER STACK upsell aside — tighter than before. */}
    <aside class="mt-12 card p-6 md:p-8 flex flex-wrap gap-4 items-center justify-between border-brand/30">
      <div>
        <p class="eyebrow"><Icon name="bolt" size={14} /> Save {founderStackDiscount}% with the AI Digital Marketing Stack</p>
        <p class="mt-2 text-fluid-base">All 6 agents · ${founderStack.priceUsd} once · lifetime updates.</p>
      </div>
      <a href="/products/founder-stack" class="btn btn-primary">
        See the bundle <Icon name="arrow-right" size={16} />
      </a>
    </aside>

    {/* SIBLINGS — uses the chip + metric surface so the catalog feels
        consistent end to end. */}
    {siblings.length > 0 && (
      <section class="mt-14">
        <p class="eyebrow"><Icon name="layers" size={14} /> More boilerplates</p>
        <ul class="mt-5 grid gap-4 md:grid-cols-2" role="list">
          {siblings.map((s) => (
            <li>
              <a href={`/products/${s.slug}`} class="card p-5 block h-full transition-transform hover:-translate-y-0.5 hover:border-brand/40">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="shrink-0 inline-flex size-9 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
                      <Icon name={s.icon} size={18} />
                    </span>
                    <div class="min-w-0">
                      <p class="code-tag">{s.sku}</p>
                      <h3 class="text-fluid-base leading-tight">{s.name}</h3>
                    </div>
                  </div>
                  <span class="font-mono text-fluid-base text-fg shrink-0">${s.priceUsd}</span>
                </div>
                <p class="mt-3 text-muted text-fluid-sm leading-snug">{s.oneLiner}</p>
                <ul class="mt-3 flex flex-wrap gap-1.5" role="list">
                  {s.chips.map((c) => <li><span class="chip">{c}</span></li>)}
                </ul>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  {/* TikTok ViewContent fire — moved client-side so the inline ttFire
      helper is available even when this page is statically pre-rendered. */}
  <script is:inline define:vars={{ sku: product.sku, value: product.priceUsd, currency: 'USD' }}>
    (() => {
      const id = `vc-${sku}-${Date.now()}`;
      window.glitchPushDL?.({
        event: 'view_item', event_id: id, currency, value,
        items: [{ item_id: sku, item_name: sku, price: value, quantity: 1, currency }],
      });
      const tt = window.ttFire;
      if (typeof tt === 'function') {
        tt('ViewContent', {
          contents: [{ content_id: sku, content_type: 'product', content_name: sku, quantity: 1, price: value }],
          content_type: 'product', currency, value,
        }, { event_id: id });
      }
      const fb = window.fbFire;
      if (typeof fb === 'function') {
        fb('ViewContent', {
          content_ids: [sku], content_name: sku, content_type: 'product',
          contents: [{ id: sku, quantity: 1, item_price: value }],
          currency, value,
        }, { event_id: id });
      }
    })();
  </script>

  {/* Geo-aware price + Buy-rail swap. Default render is USD/Stripe; for
      IN visitors we flip the price label to ₹, swap the Stripe link for
      the Razorpay-modal button, and translate the priceline copy.

      Source of truth: /cdn-cgi/trace — Cloudflare's free per-edge geo
      endpoint. Returns plain text including `loc=IN`. No 3rd-party
      service, no privacy footprint beyond what CF already sees. Cached
      in sessionStorage so subsequent navigations on the same site
      don't re-fetch. */}
  <script is:inline>
    (async () => {
      try {
        let loc = sessionStorage.getItem('cf_loc');
        if (!loc) {
          const r = await fetch('/cdn-cgi/trace', { cache: 'force-cache' });
          const txt = await r.text();
          loc = (txt.match(/^loc=([A-Z]{2})/m) || [])[1] || '';
          sessionStorage.setItem('cf_loc', loc);
        }
        if (loc !== 'IN') return;
        // Swap price label + priceline copy.
        for (const el of document.querySelectorAll('[data-geo-price],[data-geo-priceline]')) {
          const next = el.getAttribute('data-inr');
          if (next) el.textContent = next;
        }
        // Swap Buy CTA — hide US, show IN.
        document.querySelectorAll('[data-geo-cta="us"]').forEach((el) => el.classList.add('hidden'));
        document.querySelectorAll('[data-geo-cta="in"]').forEach((el) => el.classList.remove('hidden'));
      } catch { /* swallow — keep USD default if anything goes wrong */ }
    })();
  </script>
</Base>
