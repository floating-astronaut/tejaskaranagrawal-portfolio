---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import ProductSchema from '~/components/schema/ProductSchema.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import { products } from '~/lib/products';
import { bundles, bundleAlaCarteTotal, bundleDiscountPct } from '~/lib/bundles';

const bundle = bundles[0];
const alaCarte = bundleAlaCarteTotal(bundle);
const discountPct = bundleDiscountPct(bundle);

const includedProducts = bundle.includes
  .map((slug) => products.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Base
  title={bundle.name}
  description={bundle.tagline}
  pageType="WebPage"
  ogSlug="product-founder-stack"
>
  <Fragment slot="head">
    <ProductSchema
      name={bundle.name}
      description={`${bundle.tagline} ${bundle.subline}`}
      sku={bundle.sku}
      url="/products/founder-stack"
      price={bundle.priceUsd}
      priceCurrency="USD"
      offerUrl={bundle.buyUrl}
      category="AI Agent Boilerplate Bundle"
    />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Products', url: '/products' },
      { name: bundle.name, url: '/products/founder-stack' },
    ]} />
  </Fragment>
  <article class="container-app pt-14 pb-24 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/products" class="hover:text-fg">Catalog</a>
      <span class="mx-1">/</span>
      <span class="text-muted">{bundle.name}</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="inline-flex size-12 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/30">
          <Icon name="bolt" size={22} />
        </span>
        <span class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{bundle.sku}</span>
        <span class="text-fluid-xs px-2 py-0.5 rounded-md border border-brand/40 text-brand">Save {discountPct}%</span>
      </div>
      <h1 class="mt-6">{bundle.name}</h1>
      <p class="mt-5 text-fluid-lg text-muted">{bundle.tagline}</p>
      <p class="mt-4 text-fluid-base text-muted">{bundle.subline}</p>

      <div class="mt-8 card p-6 md:p-7 flex flex-wrap items-center justify-between gap-5 border-brand/30">
        <div>
          <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">All 6 agents · Lifetime updates · 14-day refund</p>
          <p class="mt-1 font-mono text-fluid-3xl text-brand leading-none">${bundle.priceUsd}</p>
          <p class="mt-1 text-fluid-xs text-subtle">
            À la carte: <span class="line-through">${alaCarte}</span> · save {discountPct}%
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={bundle.buyUrl}
            class="btn btn-primary"
            data-sku={bundle.sku}
            data-price-major={String(bundle.priceUsd)}
            data-currency="USD"
          >
            Buy {bundle.sku} <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </header>

    <div class="hairline my-12"></div>

    <section class="max-w-3xl">
      <p class="eyebrow"><Icon name="layers" size={14} /> What's included</p>
      <h2 class="mt-4 text-fluid-2xl">Six AI agents</h2>
      <ul class="mt-6 grid gap-3" role="list">
        {includedProducts.map((p) => (
          <li>
            <a href={`/products/${p.slug}`} class="card p-5 flex items-center justify-between gap-4 hover:-translate-y-0.5 transition-transform">
              <div class="flex items-center gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
                  <Icon name={p.icon} size={18} />
                </span>
                <div>
                  <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{p.sku}</p>
                  <p class="text-fluid-base font-medium">{p.name}</p>
                </div>
              </div>
              <span class="font-mono text-fluid-sm text-fg">${p.priceUsd}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16 max-w-3xl">
      <p class="eyebrow"><Icon name="spark" size={14} /> Bonuses included</p>
      <h2 class="mt-4 text-fluid-2xl">Beyond the source</h2>
      <ul class="mt-6 space-y-3" role="list">
        {bundle.bonuses.map((b) => (
          <li class="flex items-start gap-3 card p-4">
            <span class="mt-[3px] text-electric"><Icon name="check" size={16} /></span>
            <span class="text-fg/90 text-fluid-sm">{b}</span>
          </li>
        ))}
      </ul>
    </section>

    <aside class="mt-16 card p-6 md:p-8 flex flex-wrap gap-4 items-center justify-between border-brand/30">
      <div>
        <p class="eyebrow"><Icon name="bolt" size={14} /> Ready to ship in week one?</p>
        <p class="mt-2 text-fluid-lg">Six production agents + Discord + 1:1 call. ${bundle.priceUsd} · save {discountPct}%.</p>
      </div>
      <a href={bundle.buyUrl} class="btn btn-primary">
        Buy {bundle.sku} <Icon name="arrow-right" size={16} />
      </a>
    </aside>
  </article>
</Base>
