---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { products, subBrands } from '~/lib/products';
import { bundles, bundleAlaCarteTotal, bundleDiscountPct } from '~/lib/bundles';

const statusLabel: Record<typeof products[number]['status'], string> = {
  shipped: 'Shipped',
  'in-pilot': 'In pilot',
  'coming-soon': 'Coming soon',
};

const founderStack = bundles[0];
const founderStackDiscount = bundleDiscountPct(founderStack);
const founderStackAlaCarte = bundleAlaCarteTotal(founderStack);
---

<Base
  title="Catalog"
  description="The AI Digital Marketing Stack — six production agents (ads, sales, social, voice, SEO, UGC) that plug into Claude Code. Buy once, run on your infra, resell to clients at agency-tier prices."
  pageType="WebPage"
  ogSlug="products"
>
  <section class="container-app pt-16 pb-10 md:pt-24">
    <p class="eyebrow"><Icon name="layers" size={14} /> The catalog</p>
    <h1 class="mt-4">Six AI agents. One marketing stack.</h1>
    <p class="mt-5 max-w-[60ch] text-fluid-lg text-muted">
      Each agent is a self-contained, source-available repo running in
      production at Glitch Executor Labs — and an MCP that plugs into
      Claude Code. Buy one to ship a focused service, or buy the bundle
      to ship a full AI digital marketing stack. You self-host, you own
      every byte, you run whatever business you want on top.
    </p>
    <p class="mt-3 text-fluid-sm text-subtle">
      Want the long-form pitch? See the full <a href="/kit" class="text-brand underline">kit overview</a> or the <a href="/compare" class="text-brand underline">comparison matrix</a> across all 12 alternatives.
    </p>
  </section>

  <section class="container-app pb-10">
    {/* AI Digital Marketing Stack bundle banner — anchors the value before the à la carte grid */}
    <a
      href={founderStack.buyUrl}
      class="card p-6 md:p-8 flex flex-wrap gap-6 items-center justify-between hover:-translate-y-0.5 transition-transform border-brand/40 hover:border-brand"
    >
      <div class="flex items-start gap-4">
        <span class="inline-flex size-12 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/30">
          <Icon name="bolt" size={22} />
        </span>
        <div class="max-w-prose">
          <p class="font-mono text-fluid-xs text-brand uppercase tracking-wider">{founderStack.sku} · {founderStack.name}</p>
          <p class="mt-1 text-fluid-2xl font-semibold">All 6 agents + Discord lifetime + 1:1 call</p>
          <p class="mt-2 text-muted text-fluid-sm">{founderStack.tagline}</p>
        </div>
      </div>
      <div class="text-right">
        <p class="font-mono text-fluid-3xl text-brand leading-none">${founderStack.priceUsd}</p>
        <p class="mt-1 text-fluid-xs text-subtle">
          <span class="line-through">${founderStackAlaCarte}</span> · save {founderStackDiscount}%
        </p>
      </div>
    </a>
  </section>

  <section class="container-app pb-16">
    <ul role="list" class="grid gap-6 md:grid-cols-2">
      {products.map((p) => (
        <li class="card p-6 md:p-8 flex flex-col h-full transition-transform hover:-translate-y-0.5">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="inline-flex size-10 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
                <Icon name={p.icon} size={20} />
              </span>
              <div>
                <p class="font-mono text-fluid-xs text-subtle uppercase tracking-wider">{p.sku}</p>
                <h2 class="text-fluid-2xl">{p.name}</h2>
              </div>
            </div>
            <span class={`text-fluid-xs px-2 py-0.5 rounded-md border ${
              p.status === 'shipped'
                ? 'border-brand/40 text-brand'
                : p.status === 'in-pilot'
                  ? 'border-electric/40 text-electric'
                  : 'border-border text-subtle'
            }`}>
              {statusLabel[p.status]}
            </span>
          </div>
          <p class="mt-4 text-muted text-fluid-sm" set:html={p.tagline} />
          <ul class="mt-5 space-y-2 text-fluid-sm flex-1" role="list">
            {p.capabilities.slice(0, 3).map((b) => (
              <li class="flex items-start gap-2">
                <span class="mt-[3px] text-brand"><Icon name="check" size={14} /></span>
                <span class="text-fg/90">{b}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex items-center justify-between gap-4">
            <div>
              <p class="font-mono text-fluid-3xl text-fg leading-none">${p.priceUsd}</p>
              <p class="mt-1 text-fluid-xs text-subtle">One-time · Lifetime updates · 14-day refund</p>
            </div>
            <div class="flex flex-col gap-1.5 items-end shrink-0">
              <a href={p.buyUrl} class="btn btn-primary">
                Buy {p.sku} <Icon name="arrow-right" size={14} />
              </a>
              <a href={`/products/${p.slug}`} class="text-fluid-xs text-subtle hover:text-brand inline-flex items-center gap-1">
                Read the spec <Icon name="arrow-up-right" size={12} />
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  {subBrands.length > 0 && (
    <section class="container-app pb-24">
      <p class="eyebrow"><Icon name="spark" size={14} /> Sub-brand · Product line</p>
      <h2 class="mt-4">Beyond the boilerplates.</h2>
      <p class="mt-5 max-w-[60ch] text-muted">
        Sometimes the right product is a packaged SaaS for a vertical with a
        specific compliance shape. Glitch Budz is the first of those.
      </p>
      <div class="mt-10 grid gap-6">
        {subBrands.map((s) => (
          <a
            href={s.href}
            class="card p-6 md:p-8 flex flex-wrap gap-6 items-center justify-between hover:-translate-y-0.5 transition-transform"
          >
            <div class="flex items-center gap-4">
              <span class="inline-flex size-12 items-center justify-center rounded-md bg-electric/10 text-electric border border-electric/20">
                <Icon name={s.icon} size={22} />
              </span>
              <div>
                <p class="text-fluid-xl font-semibold">{s.name}</p>
                <p class="mt-1 text-muted text-fluid-sm">{s.tagline}</p>
                <p class="mt-2 text-muted text-fluid-sm max-w-prose">{s.blurb}</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1.5 text-fluid-sm">
              Visit {s.name} <Icon name="arrow-up-right" size={14} />
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
