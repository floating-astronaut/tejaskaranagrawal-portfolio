---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import WebApplicationSchema from '~/components/schema/WebApplicationSchema.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import EmbedSnippet from '~/components/EmbedSnippet.astro';
import { products } from '~/lib/products';

// Recommended monthly resale rate per agent (USD, midpoint of the
// `sellAs` range in src/lib/products.ts). Used as the input default.
const recommendedRate: Record<string, number> = {
  'ugc-agent':   60,    // $29–$99/mo managed MCP — midpoint
  'ads-agent':          1497,
  'sales-agent':        797,
  'social-media-agent': 1497,
  'cod-confirm':        2997,  // white-label seat
  'seo-agent':          60,    // $29–$99/mo App Store listing
};

const agentChoices = products.map((p) => ({
  slug: p.slug,
  name: p.name,
  sku: p.sku,
  priceUsd: p.priceUsd,
  recommended: recommendedRate[p.slug] ?? 500,
}));

const faqs = [
  {
    q: 'How is monthly margin calculated?',
    a: 'Monthly margin = (clients × monthly rate) − infrastructure cost. Margin assumes you handle the managed-service operations yourself; subtract your time at whatever hourly rate you bill internally.',
  },
  {
    q: 'How is breakeven calculated?',
    a: 'Breakeven months = the boilerplate license price ÷ monthly margin. After that point, every month nets pure margin (minus your operating time).',
  },
  {
    q: 'What if I run multiple agents for the same client?',
    a: 'Run each agent through the calculator separately and add the margins. Bundles typically command a 10–20% premium per service line beyond standalone pricing.',
  },
  {
    q: 'Are these recommended rates real?',
    a: 'They are the midpoint of the resale ranges in our agent catalog (sourced from agencies actually delivering these services). Adjust to your market — Indian D2C is materially lower than US/EU agency pricing.',
  },
];
---

<Base
  title="Agent Resale ROI Estimator"
  description="Free calculator: pick a Glitch Grow agent, set client pricing and count, see monthly margin and breakeven from the one-time license. No signup."
  pageType="WebPage"
>
  <Fragment slot="head">
    <WebApplicationSchema
      name="Agent Resale ROI Estimator"
      description="Estimate monthly margin and breakeven when reselling Glitch Grow AI-agent boilerplates to clients as a managed service."
      url="/tools/agent-roi-estimator"
      featureList={[
        '6 Glitch Grow agents preloaded with recommended resale pricing',
        'Adjustable client count and monthly rate',
        'Infra cost and breakeven months calculation',
        'Shareable result URL',
      ]}
    />
    <FAQSchema faqs={faqs} />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Tools', url: '/tools' },
      { name: 'Agent ROI Estimator', url: '/tools/agent-roi-estimator' },
    ]} />
  </Fragment>

  <article class="container-app pt-14 pb-24 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/tools" class="hover:text-fg">Tools</a>
      <span class="mx-1">/</span>
      <span class="text-muted">Agent ROI Estimator</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow"><Icon name="bolt" size={14} /> Calculator</p>
      <h1 class="mt-4">Agent Resale ROI Estimator.</h1>
      <p class="mt-5 text-fluid-lg text-muted">
        Pick an agent, set your pricing, see the monthly margin and how fast the license pays for itself.
      </p>
    </header>

    <section class="mt-10 grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="card p-6 md:p-8">
          <h2 class="text-fluid-xl">Inputs</h2>

          <div class="mt-5">
            <label for="agent-select" class="text-fluid-sm text-fg/90 font-medium">Agent</label>
            <select id="agent-select"
              class="mt-2 w-full px-3 py-2 rounded-md bg-bg-elev border border-border/60 text-fluid-sm text-fg focus:outline-none focus:ring-2 focus:ring-brand/40"
              data-calc-input
            >
              {agentChoices.map((a) => (
                <option value={a.slug} data-price={a.priceUsd} data-recommended={a.recommended}>
                  {a.sku} — {a.name} (license ${a.priceUsd})
                </option>
              ))}
            </select>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-4">
            <div>
              <label for="client-count" class="text-fluid-sm text-fg/90 font-medium">Clients</label>
              <input type="number" id="client-count" min="1" step="1" value="3"
                class="mt-2 w-full px-3 py-2 rounded-md bg-bg-elev border border-border/60 text-fluid-sm text-fg focus:outline-none focus:ring-2 focus:ring-brand/40"
                data-calc-input />
            </div>
            <div>
              <label for="monthly-rate" class="text-fluid-sm text-fg/90 font-medium">Monthly rate per client (USD)</label>
              <input type="number" id="monthly-rate" min="0" step="50" value="1497"
                class="mt-2 w-full px-3 py-2 rounded-md bg-bg-elev border border-border/60 text-fluid-sm text-fg focus:outline-none focus:ring-2 focus:ring-brand/40"
                data-calc-input />
            </div>
          </div>

          <div class="mt-5">
            <label for="infra-monthly" class="text-fluid-sm text-fg/90 font-medium">Infra cost per month (total)</label>
            <p class="mt-1 text-fluid-xs text-subtle">Default $80/mo single-VM. Scale up if your call/email volume warrants.</p>
            <input type="number" id="infra-monthly" min="0" step="10" value="80"
              class="mt-2 w-full px-3 py-2 rounded-md bg-bg-elev border border-border/60 text-fluid-sm text-fg focus:outline-none focus:ring-2 focus:ring-brand/40"
              data-calc-input />
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="card p-6 md:p-8 border-brand/30 lg:sticky lg:top-[calc(var(--header-stack-h,7rem)+1rem)]">
          <p class="label-ui text-brand">Monthly margin</p>
          <p class="mt-3 num-mono text-fluid-3xl text-fg leading-none">$<span id="result-margin">0</span></p>
          <p class="mt-1 text-fluid-xs text-subtle">(<span id="result-clients">0</span> × $<span id="result-rate">0</span>) − $<span id="result-infra">0</span> infra</p>

          <div class="hairline my-6"></div>

          <p class="label-ui text-brand">Breakeven</p>
          <p class="mt-3 num-mono text-fluid-3xl text-electric leading-none"><span id="result-breakeven">0</span> mo</p>
          <p class="mt-1 text-fluid-xs text-subtle">to recover the $<span id="result-license">0</span> license</p>

          <div class="hairline my-6"></div>

          <p class="label-ui text-brand">Year-1 net margin</p>
          <p class="mt-3 num-mono text-fluid-3xl text-fg leading-none">$<span id="result-year1">0</span></p>
          <p class="mt-1 text-fluid-xs text-subtle">(margin × 12) − license</p>

          <a href="#" id="cta-buy" class="mt-6 btn btn-primary w-full justify-center">
            Buy this agent <Icon name="arrow-right" size={16} />
          </a>
          <button type="button" id="share-btn" class="btn-link w-full justify-center mt-2 text-fluid-sm">
            <span id="share-label">Copy shareable link</span> <Icon name="arrow-up-right" size={14} />
          </button>
        </div>
      </div>
    </section>

    <EmbedSnippet
      toolPath="/tools/agent-roi-estimator"
      toolLabel="Agent Resale ROI Estimator"
    />

    <section class="mt-16 max-w-3xl">
      <h2 class="text-fluid-2xl">Frequently asked questions</h2>
      <ul class="mt-5 divide-y divide-border/60 border-y border-border/60" role="list">
        {faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none">
                <span class="text-fluid-base font-medium pr-2">{f.q}</span>
                <span aria-hidden="true" class="shrink-0 mt-1 size-6 inline-flex items-center justify-center rounded-full border border-border text-subtle transition-transform group-open:rotate-45 group-open:text-brand">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </span>
              </summary>
              <p class="pb-5 pr-8 text-fluid-sm text-muted leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </section>
  </article>

  <script is:inline>
    (() => {
      const fmt = (n) => Math.round(n).toLocaleString('en-US');
      const sel = document.getElementById('agent-select');
      const elClients = document.getElementById('client-count');
      const elRate = document.getElementById('monthly-rate');
      const elInfra = document.getElementById('infra-monthly');
      const cta = document.getElementById('cta-buy');

      const elMargin = document.getElementById('result-margin');
      const elClientsOut = document.getElementById('result-clients');
      const elRateOut = document.getElementById('result-rate');
      const elInfraOut = document.getElementById('result-infra');
      const elBreakeven = document.getElementById('result-breakeven');
      const elLicense = document.getElementById('result-license');
      const elYear1 = document.getElementById('result-year1');

      function applyParams() {
        const p = new URL(window.location.href).searchParams;
        if (p.get('agent')) sel.value = p.get('agent');
        if (p.get('clients')) elClients.value = p.get('clients');
        if (p.get('rate')) elRate.value = p.get('rate');
        if (p.get('infra')) elInfra.value = p.get('infra');
      }

      function recalc(updateRate = false) {
        const opt = sel.options[sel.selectedIndex];
        const license = Number(opt.dataset.price) || 0;
        const recommended = Number(opt.dataset.recommended) || 0;
        if (updateRate) elRate.value = String(recommended);

        const clients = Math.max(1, Number(elClients.value) || 1);
        const rate = Math.max(0, Number(elRate.value) || 0);
        const infra = Math.max(0, Number(elInfra.value) || 0);

        const margin = Math.max(0, clients * rate - infra);
        const breakeven = margin > 0 ? Math.ceil(license / margin) : 0;
        const year1 = margin * 12 - license;

        elMargin.textContent = fmt(margin);
        elClientsOut.textContent = String(clients);
        elRateOut.textContent = fmt(rate);
        elInfraOut.textContent = fmt(infra);
        elBreakeven.textContent = String(breakeven);
        elLicense.textContent = fmt(license);
        elYear1.textContent = fmt(year1);

        cta.href = `/products/${sel.value}`;

        const params = new URLSearchParams({
          agent: sel.value,
          clients: String(clients),
          rate: String(rate),
          infra: String(infra),
        });
        const newUrl = window.location.pathname + '?' + params.toString();
        window.history.replaceState(null, '', newUrl);
      }

      applyParams();
      recalc();
      sel.addEventListener('change', () => recalc(true));
      [elClients, elRate, elInfra].forEach((el) => el.addEventListener('input', () => recalc(false)));

      const shareBtn = document.getElementById('share-btn');
      const shareLabel = document.getElementById('share-label');
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareLabel.textContent = 'Copied!';
          setTimeout(() => { shareLabel.textContent = 'Copy shareable link'; }, 1600);
        } catch {
          shareLabel.textContent = 'Copy failed';
          setTimeout(() => { shareLabel.textContent = 'Copy shareable link'; }, 1600);
        }
      });
    })();
  </script>
</Base>
