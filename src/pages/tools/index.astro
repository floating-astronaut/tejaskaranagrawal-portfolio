---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';

const tools = [
  {
    slug: 'saas-vs-own-calculator',
    title: 'SaaS-vs-Own Calculator',
    blurb: 'Plug in your current Zapier / Make / n8n / Vapi spend and see your 3-year TCO vs a one-time $499 AI Digital Marketing Stack.',
    icon: 'chart' as const,
  },
  {
    slug: 'agent-roi-estimator',
    title: 'Agent Resale ROI Estimator',
    blurb: 'Pick an agent, set your client pricing, see monthly margin and breakeven from the one-time license cost.',
    icon: 'bolt' as const,
  },
  {
    slug: 'prompt-cost-estimator',
    title: 'Prompt Cost Estimator',
    blurb: 'Model + token volume → monthly cost across Claude, GPT-4o, Gemini, and self-hosted Llama.',
    icon: 'cpu' as const,
  },
];
---

<Base
  title="Free tools for AI agencies"
  description="Free calculators for AI agencies and indie devs: SaaS-vs-Own TCO, agent resale ROI, prompt cost estimator. No signup, shareable result URLs."
  pageType="WebPage"
>
  <article class="container-app pt-14 pb-20 md:pt-20">
    <header class="max-w-3xl">
      <p class="eyebrow"><Icon name="bolt" size={14} /> Free tools</p>
      <h1 class="mt-4">Free tools for AI agencies.</h1>
      <p class="mt-5 text-fluid-lg text-muted">
        No signup. No email gate. Result URLs are shareable — paste them in Slack with a client and the numbers load.
      </p>
    </header>

    <ul class="mt-10 grid gap-4 md:grid-cols-3" role="list">
      {tools.map((t) => (
        <li>
          <a href={`/tools/${t.slug}`} class="card p-6 block h-full hover:-translate-y-0.5 transition-transform hover:border-brand/40">
            <span class="inline-flex size-10 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
              <Icon name={t.icon} size={20} />
            </span>
            <h2 class="mt-4 text-fluid-lg font-medium leading-tight">{t.title}</h2>
            <p class="mt-3 text-muted text-fluid-sm leading-snug">{t.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </article>
</Base>
