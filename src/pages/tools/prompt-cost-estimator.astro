---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import WebApplicationSchema from '~/components/schema/WebApplicationSchema.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import BreadcrumbSchema from '~/components/schema/BreadcrumbSchema.astro';
import EmbedSnippet from '~/components/EmbedSnippet.astro';

// Per-million-token list pricing in USD. Sourced from each provider's
// public pricing page. Update when pricing changes — keep "asOf" current.
const models = [
  { id: 'claude-opus-4.7',     label: 'Claude Opus 4.7',     inputPerM: 15.00, outputPerM: 75.00 },
  { id: 'claude-sonnet-4.6',   label: 'Claude Sonnet 4.6',   inputPerM:  3.00, outputPerM: 15.00 },
  { id: 'claude-haiku-4',      label: 'Claude Haiku 4',      inputPerM:  0.80, outputPerM:  4.00 },
  { id: 'gpt-4o',              label: 'GPT-4o',              inputPerM:  2.50, outputPerM: 10.00 },
  { id: 'gpt-4o-mini',         label: 'GPT-4o-mini',         inputPerM:  0.15, outputPerM:  0.60 },
  { id: 'gpt-5',               label: 'GPT-5',               inputPerM:  5.00, outputPerM: 15.00 },
  { id: 'gemini-2.5-pro',      label: 'Gemini 2.5 Pro',      inputPerM:  1.25, outputPerM:  5.00 },
  { id: 'gemini-2.5-flash',    label: 'Gemini 2.5 Flash',    inputPerM:  0.075, outputPerM: 0.30 },
  { id: 'llama-3.1-70b-self',  label: 'Llama 3.1 70B (self-host est.)', inputPerM: 0.30, outputPerM: 0.30 },
];

const asOf = '2026-05';

const faqs = [
  {
    q: 'How is monthly cost calculated?',
    a: 'Cost = (input tokens × input price/M) + (output tokens × output price/M), then × calls per day × 30 days. Token counts are approximate — actual cost depends on tokenization specifics.',
  },
  {
    q: 'How big is an average prompt?',
    a: 'Heuristic: 1 token ≈ 0.75 words in English. A 500-word system prompt + 100-word user message ≈ 800 input tokens. Output varies hugely — short JSON ≈ 50 tokens, long-form ≈ 500–2,000.',
  },
  {
    q: 'Why is self-hosted Llama "estimated"?',
    a: 'Self-hosting has no per-token pricing — your cost is GPU time. We approximate $0.30/M tokens both directions based on a typical H100 deployment at common throughput. Real cost depends on hardware utilization.',
  },
  {
    q: 'Are these prices current?',
    a: `Last updated ${asOf}. Provider pricing changes frequently — always confirm with the official pricing page before committing budget.`,
  },
];
---

<Base
  title="Prompt Cost Estimator — monthly LLM API spend across Claude, GPT, Gemini"
  description="Free calculator: model + token volume → monthly LLM cost across Claude Opus/Sonnet/Haiku, GPT-4o, GPT-5, Gemini 2.5 Pro/Flash, and self-hosted Llama. Shareable URL."
  pageType="WebPage"
>
  <Fragment slot="head">
    <WebApplicationSchema
      name="Prompt Cost Estimator"
      description="Estimate monthly LLM API spend across Claude, GPT, Gemini, and self-hosted Llama based on token volume and call frequency."
      url="/tools/prompt-cost-estimator"
      featureList={[
        '9 models including Claude 4.6/4.7, GPT-4o/5, Gemini 2.5, Llama 3.1',
        'Adjustable input/output tokens per call and calls per day',
        'Monthly and annual cost projection',
        'Shareable result URL',
      ]}
    />
    <FAQSchema faqs={faqs} />
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Tools', url: '/tools' },
      { name: 'Prompt Cost Estimator', url: '/tools/prompt-cost-estimator' },
    ]} />
  </Fragment>

  <article class="container-app pt-14 pb-24 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-fluid-xs text-subtle">
      <a href="/tools" class="hover:text-fg">Tools</a>
      <span class="mx-1">/</span>
      <span class="text-muted">Prompt Cost Estimator</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow"><Icon name="cpu" size={14} /> Calculator</p>
      <h1 class="mt-4">Prompt Cost Estimator.</h1>
      <p class="mt-5 text-fluid-lg text-muted">
        Pick a model, set token volume, get monthly and annual cost. Last updated {asOf}.
      </p>
    </header>

    <section class="mt-10 grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="card p-6 md:p-8">
          <h2 class="text-fluid-xl">Inputs</h2>

          <div class="mt-5">
            <label for="model-select" class="text-fluid-sm text-fg/90 font-medium">Model</label>
            <select id="model-select"
              class="mt-2 w-full px-3 py-2 rounded-md bg-bg-elev border border-border/60 text-fluid-sm text-fg focus:outline-none focus:ring-2 focus:ring-brand/40"
              data-calc-input
            >
              {models.map((m) => (
                <option value={m.id} data-input={m.inputPerM} data-output={m.outputPerM}>
                  {m.label} — ${m.inputPerM}/M in, ${m.outputPerM}/M out
                </option>
              ))}
            </select>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-4">
            <div>
              <label for="in-tokens" class="text-fluid-sm text-fg/90 font-medium">Input tokens / call</label>
              <input type="number" id="in-tokens" min="0" step="100" value="1500"
                class="mt-2 w-full px-3 py-2 rounded-md bg-bg-elev border border-border/60 text-fluid-sm text-fg focus:outline-none focus:ring-2 focus:ring-brand/40"
                data-calc-input />
            </div>
            <div>
              <label for="out-tokens" class="text-fluid-sm text-fg/90 font-medium">Output tokens / call</label>
              <input type="number" id="out-tokens" min="0" step="100" value="500"
                class="mt-2 w-full px-3 py-2 rounded-md bg-bg-elev border border-border/60 text-fluid-sm text-fg focus:outline-none focus:ring-2 focus:ring-brand/40"
                data-calc-input />
            </div>
          </div>

          <div class="mt-5">
            <label for="calls-day" class="text-fluid-sm text-fg/90 font-medium">Calls per day</label>
            <input type="number" id="calls-day" min="0" step="100" value="1000"
              class="mt-2 w-full px-3 py-2 rounded-md bg-bg-elev border border-border/60 text-fluid-sm text-fg focus:outline-none focus:ring-2 focus:ring-brand/40"
              data-calc-input />
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="card p-6 md:p-8 border-brand/30 lg:sticky lg:top-[calc(var(--header-stack-h,7rem)+1rem)]">
          <p class="label-ui text-brand">Cost per call</p>
          <p class="mt-3 num-mono text-fluid-2xl text-fg leading-none">$<span id="result-call">0</span></p>

          <div class="hairline my-6"></div>

          <p class="label-ui text-brand">Cost per day</p>
          <p class="mt-3 num-mono text-fluid-2xl text-fg leading-none">$<span id="result-day">0</span></p>

          <div class="hairline my-6"></div>

          <p class="label-ui text-brand">Monthly</p>
          <p class="mt-3 num-mono text-fluid-3xl text-electric leading-none">$<span id="result-month">0</span></p>
          <p class="mt-1 text-fluid-xs text-subtle">~30 days × calls/day</p>

          <div class="hairline my-6"></div>

          <p class="label-ui text-brand">Annual</p>
          <p class="mt-3 num-mono text-fluid-2xl text-fg leading-none">$<span id="result-year">0</span></p>

          <button type="button" id="share-btn" class="btn-link w-full justify-center mt-6 text-fluid-sm">
            <span id="share-label">Copy shareable link</span> <Icon name="arrow-up-right" size={14} />
          </button>
        </div>
      </div>
    </section>

    <EmbedSnippet
      toolPath="/tools/prompt-cost-estimator"
      toolLabel="Prompt Cost Estimator"
      height={780}
    />

    <section class="mt-16 max-w-3xl">
      <h2 class="text-fluid-2xl">Frequently asked questions</h2>
      <ul class="mt-5 divide-y divide-border/60 border-y border-border/60" role="list">
        {faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none">
                <span class="text-fluid-base font-medium pr-2">{f.q}</span>
                <span aria-hidden="true" class="shrink-0 mt-1 size-6 inline-flex items-center justify-center rounded-full border border-border text-subtle transition-transform group-open:rotate-45 group-open:text-brand">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </span>
              </summary>
              <p class="pb-5 pr-8 text-fluid-sm text-muted leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </section>
  </article>

  <script is:inline>
    (() => {
      const fmt = (n) => {
        if (n < 1) return n.toFixed(4);
        if (n < 100) return n.toFixed(2);
        return Math.round(n).toLocaleString('en-US');
      };
      const sel = document.getElementById('model-select');
      const inT = document.getElementById('in-tokens');
      const outT = document.getElementById('out-tokens');
      const calls = document.getElementById('calls-day');

      const elCall = document.getElementById('result-call');
      const elDay = document.getElementById('result-day');
      const elMonth = document.getElementById('result-month');
      const elYear = document.getElementById('result-year');

      function applyParams() {
        const p = new URL(window.location.href).searchParams;
        if (p.get('m')) sel.value = p.get('m');
        if (p.get('in')) inT.value = p.get('in');
        if (p.get('out')) outT.value = p.get('out');
        if (p.get('calls')) calls.value = p.get('calls');
      }

      function recalc() {
        const opt = sel.options[sel.selectedIndex];
        const inPrice = Number(opt.dataset.input);
        const outPrice = Number(opt.dataset.output);
        const i = Math.max(0, Number(inT.value) || 0);
        const o = Math.max(0, Number(outT.value) || 0);
        const c = Math.max(0, Number(calls.value) || 0);

        const perCall = (i / 1_000_000) * inPrice + (o / 1_000_000) * outPrice;
        const perDay = perCall * c;
        const perMonth = perDay * 30;
        const perYear = perMonth * 12;

        elCall.textContent = fmt(perCall);
        elDay.textContent = fmt(perDay);
        elMonth.textContent = fmt(perMonth);
        elYear.textContent = fmt(perYear);

        const params = new URLSearchParams({ m: sel.value, in: String(i), out: String(o), calls: String(c) });
        window.history.replaceState(null, '', window.location.pathname + '?' + params.toString());
      }

      applyParams();
      recalc();
      [sel, inT, outT, calls].forEach((el) => el.addEventListener('input', recalc));
      sel.addEventListener('change', recalc);

      const shareBtn = document.getElementById('share-btn');
      const shareLabel = document.getElementById('share-label');
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareLabel.textContent = 'Copied!';
          setTimeout(() => { shareLabel.textContent = 'Copy shareable link'; }, 1600);
        } catch {
          shareLabel.textContent = 'Copy failed';
          setTimeout(() => { shareLabel.textContent = 'Copy shareable link'; }, 1600);
        }
      });
    })();
  </script>
</Base>
