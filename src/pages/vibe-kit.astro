---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
---

<Base title="Glitch Vibe Kit" description="Free AI coding agent setup kit for Claude Code, Codex, Cursor, Hermes, OpenClaw, NemoClaw, and Aider." pageType="WebPage" ogSlug="home">
  <div class="pt-[var(--header-stack-h,calc(var(--nav-h)+2.25rem))]">
    <section class="container-app py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="eyebrow"><Icon name="spark" size={14} /> Free setup kit</p>
        <h1 class="mt-5">Glitch Vibe Kit</h1>
        <p class="mt-6 text-fluid-lg text-muted leading-relaxed">
          Set up Claude Code, Codex, Cursor, OpenClaw, Hermes, NemoClaw, or Aider with a safe MCP roster, starter rules, useful skills, and project templates before installing any paid Glitch Grow agent.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/vibe-kit/latest.zip" download>
            Download ZIP
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn-secondary" href="https://codeberg.org/Glitch_Exec_Lab/glitch-vibe-kit" target="_blank" rel="noopener">
            View on Codeberg
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-border/60 py-14 md:py-18">
      <div class="container-app grid gap-8 md:grid-cols-3">
        <div>
          <h2 class="text-fluid-xl">Agent-agnostic</h2>
          <p class="mt-3 text-muted">One setup baseline for Claude Code, Codex, Cursor, OpenClaw, Hermes, NemoClaw, and Aider.</p>
        </div>
        <div>
          <h2 class="text-fluid-xl">MCP-ready</h2>
          <p class="mt-3 text-muted">Includes a placeholder MCP roster for GitHub, Postgres, Stripe, Shopify, Brave Search, and filesystem access.</p>
        </div>
        <div>
          <h2 class="text-fluid-xl">Required prep</h2>
          <p class="mt-3 text-muted">Install this first so paid agent setup starts from a known working config instead of ad-hoc tool wiring.</p>
        </div>
      </div>
    </section>
  </div>
</Base>
